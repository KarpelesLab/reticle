# Digilent Basys 3 (Xilinx XC7A35T-1CPG236C): the clock and the sixteen
# LEDs, for `blink_carry.v`.
#
# PROVENANCE: transcribed from `examples/soc/board/basys3.rcf`, which
# transcribes Digilent's published `Basys-3-Master.xdc`. W5 is the board's
# 100 MHz oscillator. The LEDs are outputs only and the board drives none
# of these balls; no switch or button is named here.
#
# LED 6 is U14, the one LED ball of the sixteen that sits in a
# `LIOB33_SING` tile — the single-IOB tile at the bottom end of bank 14.
# This file leaves it out because the flow had no bits for that tile type
# when the design was written. It has them now
# (`fpga::xray::TileAlias`), the ball itself was never the problem, and
# `examples/basys3/io_exercise.rcf` constrains all sixteen LEDs; the
# split into `led_lo` (LEDs 0 to 5) and `led_hi` (LEDs 7 to 15) is kept
# so the design's LED-to-bit table still reads as it was written.
#
# LVCMOS33 is the only IO standard this flow has bits for.
set_io -io_standard LVCMOS33 clk W5
set_io -io_standard LVCMOS33 led_lo[0] U16
set_io -io_standard LVCMOS33 led_lo[1] E19
set_io -io_standard LVCMOS33 led_lo[2] U19
set_io -io_standard LVCMOS33 led_lo[3] V19
set_io -io_standard LVCMOS33 led_lo[4] W18
set_io -io_standard LVCMOS33 led_lo[5] U15
set_io -io_standard LVCMOS33 led_hi[0] V14
set_io -io_standard LVCMOS33 led_hi[1] V13
set_io -io_standard LVCMOS33 led_hi[2] V3
set_io -io_standard LVCMOS33 led_hi[3] W3
set_io -io_standard LVCMOS33 led_hi[4] U3
set_io -io_standard LVCMOS33 led_hi[5] P3
set_io -io_standard LVCMOS33 led_hi[6] N3
set_io -io_standard LVCMOS33 led_hi[7] P1
set_io -io_standard LVCMOS33 led_hi[8] L1
create_clock -name sys -period 10.0 clk
clock_domain sys clk
