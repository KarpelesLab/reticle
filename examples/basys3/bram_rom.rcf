# Digilent Basys 3 (Xilinx XC7A35T-1CPG236C): the oscillator, eight slide
# switches and eight LEDs, for `bram_rom.v`.
#
# PROVENANCE: the pin names are transcribed from
# `examples/soc/board/basys3.rcf`, which transcribes Digilent's published
# `Basys-3-Master.xdc`. W5 is the 100 MHz oscillator. sw[0..7] are slide
# switches SW0..SW7 (V17 V16 W16 W17 W15 V15 W14 W13). led[0..7] are
# LD7..LD14 (V14 V13 V3 W3 U3 P3 N3 P1); LD6 (U14) is skipped on purpose,
# see the design's header.
#
# The switches are inputs only: nothing here drives a pin the board
# drives. LVCMOS33 is the only IO standard any of this has been tried with.
set_io -io_standard LVCMOS33 clk W5
set_io -io_standard LVCMOS33 sw[0] V17
set_io -io_standard LVCMOS33 sw[1] V16
set_io -io_standard LVCMOS33 sw[2] W16
set_io -io_standard LVCMOS33 sw[3] W17
set_io -io_standard LVCMOS33 sw[4] W15
set_io -io_standard LVCMOS33 sw[5] V15
set_io -io_standard LVCMOS33 sw[6] W14
set_io -io_standard LVCMOS33 sw[7] W13
set_io -io_standard LVCMOS33 led[0] V14
set_io -io_standard LVCMOS33 led[1] V13
set_io -io_standard LVCMOS33 led[2] V3
set_io -io_standard LVCMOS33 led[3] W3
set_io -io_standard LVCMOS33 led[4] U3
set_io -io_standard LVCMOS33 led[5] P3
set_io -io_standard LVCMOS33 led[6] N3
set_io -io_standard LVCMOS33 led[7] P1
create_clock -name sys -period 10.0 clk
clock_domain sys clk
