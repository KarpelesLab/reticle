# Digilent Basys 3 (Xilinx XC7A35T-1CPG236C): everything on the board
# that `io_exercise.v` can reach.
#
# PROVENANCE: transcribed from `examples/soc/board/basys3.rcf`, which
# transcribes Digilent's published `Basys-3-Master.xdc`. The point of the
# design this file belongs to is to turn that transcription into a
# measurement, so treat every line here as the thing under test and not
# as a given. One line of it has already been found wrong: the switch
# order, which the board says runs right to left.
#
# `sw[0]` is the RIGHT-hand switch and `led[0]` is the RIGHT-hand LED,
# CHECKED on 8 October 2026 by flipping SW0 and SW1 and watching U16.
#
# LD6 (ball U14) used to be absent from this file: it is the one LED ball
# of the sixteen in a `LIOB33_SING` tile, and until the alias
# `tilegrid.json` puts on that tile's bit window was read
# (`fpga::xray::TileAlias`) the flow had no bits to set there and refused
# the pin. It is here now, so `led[n]` is LDn for all sixteen. The ball
# itself was never the problem — the board's owner confirms LD6 works,
# and `artix7/harness/basys3/swbut/design.txt` has Vivado driving U14 as
# `dout[6]` on this very board.
set_io -io_standard LVCMOS33 clk W5

set_io -io_standard LVCMOS33 sw[0]  V17
set_io -io_standard LVCMOS33 sw[1]  V16
set_io -io_standard LVCMOS33 sw[2]  W16
set_io -io_standard LVCMOS33 sw[3]  W17
set_io -io_standard LVCMOS33 sw[4]  W15
set_io -io_standard LVCMOS33 sw[5]  V15
set_io -io_standard LVCMOS33 sw[6]  W14
set_io -io_standard LVCMOS33 sw[7]  W13
set_io -io_standard LVCMOS33 sw[8]  V2
set_io -io_standard LVCMOS33 sw[9]  T3
set_io -io_standard LVCMOS33 sw[10] T2
set_io -io_standard LVCMOS33 sw[11] R3
set_io -io_standard LVCMOS33 sw[12] W2
set_io -io_standard LVCMOS33 sw[13] U1
set_io -io_standard LVCMOS33 sw[14] T1
set_io -io_standard LVCMOS33 sw[15] R2

# BTNC, BTNU, BTND, BTNL, BTNR. Active high, no external pull.
set_io -io_standard LVCMOS33 btn_c U18
set_io -io_standard LVCMOS33 btn_u T18
set_io -io_standard LVCMOS33 btn_d U17
set_io -io_standard LVCMOS33 btn_l W19
set_io -io_standard LVCMOS33 btn_r T17

# LD0..LD15, in the order `artix7/harness/basys3/swbut/design.txt` gives
# them: that file is Vivado's own placement for this board and lists
# `dout[0]`..`dout[15]` as U16 E19 U19 V19 W18 U15 U14 V14 V13 V3 W3 U3
# P3 N3 P1 L1. So the sixth of them is U14, which is LD6.
set_io -io_standard LVCMOS33 led[0]  U16
set_io -io_standard LVCMOS33 led[1]  E19
set_io -io_standard LVCMOS33 led[2]  U19
set_io -io_standard LVCMOS33 led[3]  V19
set_io -io_standard LVCMOS33 led[4]  W18
set_io -io_standard LVCMOS33 led[5]  U15
set_io -io_standard LVCMOS33 led[6]  U14
set_io -io_standard LVCMOS33 led[7]  V14
set_io -io_standard LVCMOS33 led[8]  V13
set_io -io_standard LVCMOS33 led[9]  V3
set_io -io_standard LVCMOS33 led[10] W3
set_io -io_standard LVCMOS33 led[11] U3
set_io -io_standard LVCMOS33 led[12] P3
set_io -io_standard LVCMOS33 led[13] N3
set_io -io_standard LVCMOS33 led[14] P1
set_io -io_standard LVCMOS33 led[15] L1

# Segments a..g, the decimal point, and the four digit anodes.
# **`an[0]` is the RIGHT-hand digit**, CHECKED 8 October 2026 by reading
# `1f29` off the glass in `selftest.v` — a status byte then a sequence
# number in that order — so the most significant nibble is leftmost.
set_io -io_standard LVCMOS33 seg[0] W7
set_io -io_standard LVCMOS33 seg[1] W6
set_io -io_standard LVCMOS33 seg[2] U8
set_io -io_standard LVCMOS33 seg[3] V8
set_io -io_standard LVCMOS33 seg[4] U5
set_io -io_standard LVCMOS33 seg[5] V5
set_io -io_standard LVCMOS33 seg[6] U7
set_io -io_standard LVCMOS33 dp     V7
set_io -io_standard LVCMOS33 an[0]  U2
set_io -io_standard LVCMOS33 an[1]  U4
set_io -io_standard LVCMOS33 an[2]  V4
set_io -io_standard LVCMOS33 an[3]  W4

create_clock -name sys -period 10.0 clk
clock_domain sys clk
