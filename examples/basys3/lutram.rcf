# Digilent Basys 3 (Xilinx XC7A35T-1CPG236C): the pins `lutram.v` uses.
#
# PROVENANCE: the pin names are transcribed from
# `examples/soc/board/basys3.rcf`, which transcribes Digilent's published
# `Basys-3-Master.xdc`. W5 is the 100 MHz oscillator, U18 the centre
# pushbutton BTNC, V17..R3 slide switches SW0..SW11, U16..V19 LEDs
# LD0..LD3, U15 LD5 and V14 LD7. (LD6, U14, is the one pin of a
# `LIOB33_SING` tile, a single-buffer IO tile this flow has no table for,
# which is why the write strobe is on LD5.) Every one of them is an input
# the board drives into the FPGA or an LED the FPGA drives; nothing here
# drives a pin the board drives.
#
# NOTHING BUILT WITH THIS FILE HAS BEEN RUN ON A BOARD.
set_io -io_standard LVCMOS33 clk W5
set_io -io_standard LVCMOS33 btn U18
set_io -io_standard LVCMOS33 waddr[0] V17
set_io -io_standard LVCMOS33 waddr[1] V16
set_io -io_standard LVCMOS33 waddr[2] W16
set_io -io_standard LVCMOS33 waddr[3] W17
set_io -io_standard LVCMOS33 wdata[0] W15
set_io -io_standard LVCMOS33 wdata[1] V15
set_io -io_standard LVCMOS33 wdata[2] W14
set_io -io_standard LVCMOS33 wdata[3] W13
set_io -io_standard LVCMOS33 raddr[0] V2
set_io -io_standard LVCMOS33 raddr[1] T3
set_io -io_standard LVCMOS33 raddr[2] T2
set_io -io_standard LVCMOS33 raddr[3] R3
set_io -io_standard LVCMOS33 rdata[0] U16
set_io -io_standard LVCMOS33 rdata[1] E19
set_io -io_standard LVCMOS33 rdata[2] U19
set_io -io_standard LVCMOS33 rdata[3] V19
set_io -io_standard LVCMOS33 wrote U15
set_io -io_standard LVCMOS33 alive V14
create_clock -name sys -period 10.0 clk
clock_domain sys clk
