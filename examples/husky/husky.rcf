# NewAE ChipWhisperer-Husky (XC7A35T-FTG256): every pin of `cwhusky_top`.
#
# PROVENANCE: transcribed by script from NewAE's `fpga/vivado/cwhusky.xdc`
# at chipwhisperer-husky-fpga 2dfe1bc, one `set_io` per
# `set_property -dict { PACKAGE_PIN ... IOSTANDARD ... }`, in the file's
# order, with its `DRIVE 8` on the four LEDs and its `PULLTYPE PULLDOWN`
# on target_io4. USERIO_CLK's pull-up is not here: it is a `PULLUP` cell
# in `userio.v`, and the cell is what sets it.
#
# Not carried over: the timing exceptions (`set_false_path`,
# `set_clock_groups`, `set_max_delay`, the IO delays), the generated
# clocks, and the clocks Vivado declares on internal nets — Reticle's
# constraints name ports. The three clocks below are the ones on ports.
create_clock -name clk_usb -period 10.4 clk_usb
create_clock -name target_hs1 -period 20.0 target_hs1
create_clock -name AUXIO -period 20.0 AUXIO
set_io -io_standard LVCMOS33 -drive 8 LED_ADC C7
set_io -io_standard LVCMOS33 -drive 8 LED_GLITCH C6
set_io -io_standard LVCMOS33 -drive 8 LED_ARMED D3
set_io -io_standard LVCMOS33 -drive 8 LED_CAP C3
set_io -io_standard LVCMOS33 clk_usb D4
set_io -io_standard LVCMOS33 USB_Data[7] L3
set_io -io_standard LVCMOS33 USB_Data[6] L2
set_io -io_standard LVCMOS33 USB_Data[5] B6
set_io -io_standard LVCMOS33 USB_Data[4] G2
set_io -io_standard LVCMOS33 USB_Data[3] G1
set_io -io_standard LVCMOS33 USB_Data[2] E2
set_io -io_standard LVCMOS33 USB_Data[1] A7
set_io -io_standard LVCMOS33 USB_Data[0] B7
set_io -io_standard LVCMOS33 USB_Addr[7] K2
set_io -io_standard LVCMOS33 USB_Addr[6] J1
set_io -io_standard LVCMOS33 USB_Addr[5] H1
set_io -io_standard LVCMOS33 USB_Addr[4] K3
set_io -io_standard LVCMOS33 USB_Addr[3] K1
set_io -io_standard LVCMOS33 USB_Addr[2] E1
set_io -io_standard LVCMOS33 USB_Addr[1] D1
set_io -io_standard LVCMOS33 USB_Addr[0] C1
set_io -io_standard LVCMOS33 USB_RDn A5
set_io -io_standard LVCMOS33 USB_WRn A4
set_io -io_standard LVCMOS33 USB_CEn B4
set_io -io_standard LVCMOS33 USB_ALEn B5
set_io -io_standard LVCMOS33 USB_SPARE0 H2
set_io -io_standard LVCMOS33 FPGA_BONUS1 R1
set_io -io_standard LVCMOS33 FPGA_BONUS2 P1
set_io -io_standard LVCMOS33 FPGA_BONUS3 N1
set_io -io_standard LVCMOS33 FPGA_BONUS4 N2
set_io -io_standard LVCMOS33 target_PDID T2
set_io -io_standard LVCMOS33 target_SCK N3
set_io -io_standard LVCMOS33 target_io2 R2
set_io -io_standard LVCMOS33 target_MISO B2
set_io -io_standard LVCMOS33 target_io1 B1
set_io -io_standard LVCMOS33 target_hs2 A3
set_io -io_standard LVCMOS33 -pulldown yes target_io4 T4
set_io -io_standard LVCMOS33 target_io3 T3
set_io -io_standard LVCMOS33 target_PDIC P3
set_io -io_standard LVCMOS33 target_MOSI C2
set_io -io_standard LVCMOS33 target_nRST A2
set_io -io_standard LVCMOS33 target_hs1 F5
set_io -io_standard LVCMOS33 target_poweron H3
set_io -io_standard LVCMOS33 USERIO_D[0] T15
set_io -io_standard LVCMOS33 USERIO_D[1] T14
set_io -io_standard LVCMOS33 USERIO_D[2] R13
set_io -io_standard LVCMOS33 USERIO_D[3] T13
set_io -io_standard LVCMOS33 USERIO_D[4] R12
set_io -io_standard LVCMOS33 USERIO_D[5] T12
set_io -io_standard LVCMOS33 USERIO_D[6] R11
set_io -io_standard LVCMOS33 USERIO_D[7] T10
set_io -io_standard LVCMOS33 USERIO_CLK N12
set_io -io_standard LVCMOS33 TRIG_GLITCHOUT R15
set_io -io_standard LVCMOS33 AUXIO N14
set_io -io_standard LVCMOS33 SAM_MOSI T7
set_io -io_standard LVCMOS33 SAM_MISO R7
set_io -io_standard LVCMOS33 SAM_SPCK T8
set_io -io_standard LVCMOS33 SAM_CS T9
set_io -io_standard LVCMOS33 FPGA_CDIN J13
set_io -io_standard LVCMOS33 FPGA_CDOUT J14
set_io -io_standard LVCMOS25 ADC_SCLK A9
set_io -io_standard LVCMOS25 ADC_SDATA B9
set_io -io_standard LVCMOS25 ADC_SEN A8
set_io -io_standard LVCMOS25 ADC_RESET A10
set_io -io_standard LVCMOS25 ADC_DFS G12
set_io -io_standard LVCMOS25 ADC_OE H12
set_io -io_standard LVCMOS25 ADC_OVR_SDOUT G16
set_io -io_standard LVDS_25 ADC_DP[0] B12
set_io -io_standard LVDS_25 ADC_DN[0] A12
set_io -io_standard LVDS_25 ADC_DP[1] A13
set_io -io_standard LVDS_25 ADC_DN[1] A14
set_io -io_standard LVDS_25 ADC_DP[2] B15
set_io -io_standard LVDS_25 ADC_DN[2] A15
set_io -io_standard LVDS_25 ADC_DP[3] C16
set_io -io_standard LVDS_25 ADC_DN[3] B16
set_io -io_standard LVDS_25 ADC_DP[4] D14
set_io -io_standard LVDS_25 ADC_DN[4] D15
set_io -io_standard LVDS_25 ADC_DP[5] F15
set_io -io_standard LVDS_25 ADC_DN[5] E15
set_io -io_standard LVDS_25 ADC_CLKP J15
set_io -io_standard LVDS_25 ADC_CLKN J16
set_io -io_standard LVDS_25 ADC_clk_fbp E12
set_io -io_standard LVDS_25 ADC_clk_fbn E13
set_io -io_standard LVCMOS25 PLL_STATUS C11
set_io -io_standard LVDS_25 PLLFPGAP D13
set_io -io_standard LVDS_25 PLLFPGAN C13
set_io -io_standard LVCMOS33 VMAG_D[4] L15
set_io -io_standard LVCMOS33 VMAG_D[3] M16
set_io -io_standard LVCMOS33 VMAG_D[2] M15
set_io -io_standard LVCMOS33 VMAG_D[1] N16
set_io -io_standard LVCMOS33 VMAG_D[0] P16
set_io -io_standard LVCMOS33 VDBSPWM R16
set_io -io_standard LVCMOS33 glitchout_highpwr C4
set_io -io_standard LVCMOS33 glitchout_lowpwr E3

# NewAE's false paths, transcribed by script from cwhusky_100.xdc (the
# Husky's cwhusky.xdc has the same set). A port is named as itself, every
# bit of it (NewAE name VMAG_D[0] to [4] one by one: all of them); a
# register's clock pin `-to [all_registers]` is a false path from that
# register; `reg_arm_pipe_reg[0]/D` is every bit of `reg_arm_pipe` here,
# its first stage being the only one a path from elsewhere reaches. Two are
# not here: the trace module's pulse synchronisers, `-from .../src_req_reg/C
# -to .../req_pipe_reg[0]/D` and its acknowledgement, which cross clock
# domains and so are not timed anyway.
set_false_path -from ADC_OVR_SDOUT
set_false_path -from ADC_clk_fbp
set_false_path -from AUXIO
set_false_path -from FPGA_CDOUT
set_false_path -from PLLFPGAP
set_false_path -from PLL_STATUS
set_false_path -from USERIO_CLK
set_false_path -from USERIO_D
set_false_path -from U_trace_top.U_reg_main.reg_capture_len*
set_false_path -from U_trace_top.U_reg_main.reg_capture_while_trig*
set_false_path -from U_trace_top.U_reg_main.reg_count_writes*
set_false_path -from U_trace_top.U_reg_main.reg_counter_quick_start*
set_false_path -from U_trace_top.U_reg_main.reg_max_timestamp*
set_false_path -from U_trace_top.U_reg_main.reg_num_triggers*
set_false_path -from U_trace_top.U_reg_main.reg_reset*
set_false_path -from U_trace_top.U_reg_main.reg_timestamps_disable*
set_false_path -from U_trace_top.U_reg_main.reg_trigger_delay*
set_false_path -from U_trace_top.U_reg_main.reg_trigger_enable*
set_false_path -from U_trace_top.U_reg_main.reg_trigger_width*
set_false_path -from U_trace_top.U_reg_trace.O_capture_raw*
set_false_path -from U_trace_top.U_reg_trace.O_pattern_enable*
set_false_path -from U_trace_top.U_reg_trace.O_pattern_trig_enable*
set_false_path -from U_trace_top.U_reg_trace.O_record_syncs*
set_false_path -from U_trace_top.U_reg_trace.O_soft_trig_enable*
set_false_path -from U_trace_top.U_reg_trace.O_swo_bitrate_div*
set_false_path -from U_trace_top.U_reg_trace.O_swo_enable*
set_false_path -from U_trace_top.U_reg_trace.O_trace_mask**
set_false_path -from U_trace_top.U_reg_trace.O_trace_pattern**
set_false_path -from U_trace_top.U_reg_trace.O_trace_width*
set_false_path -from U_trace_top.U_reg_trace.O_uart_data_bits*
set_false_path -from U_trace_top.U_reg_trace.O_uart_stop_bits*
set_false_path -from target_io1
set_false_path -from target_io2
set_false_path -from target_io3
set_false_path -from target_io4
set_false_path -from target_nRST
set_false_path -to ADC_CLKP
set_false_path -to ADC_DFS
set_false_path -to ADC_OE
set_false_path -to ADC_RESET
set_false_path -to ADC_SCLK
set_false_path -to ADC_SDATA
set_false_path -to ADC_SEN
set_false_path -to AUXIO
set_false_path -to FPGA_CDIN
set_false_path -to LED_ADC
set_false_path -to LED_ARMED
set_false_path -to LED_CAP
set_false_path -to LED_GLITCH
set_false_path -to SAM_MISO
set_false_path -to TRIG_GLITCHOUT
set_false_path -to USB_SPARE0
set_false_path -to USERIO_CLK
set_false_path -to USERIO_D
set_false_path -to U_trace_top.U_reg_main.reg_arm_pipe*
set_false_path -to VDBSPWM
set_false_path -to VMAG_D
set_false_path -to glitchout_highpwr
set_false_path -to glitchout_lowpwr
set_false_path -to target_MOSI
set_false_path -to target_PDIC
set_false_path -to target_PDID
set_false_path -to target_SCK
set_false_path -to target_hs2
set_false_path -to target_io1
set_false_path -to target_io2
set_false_path -to target_io3
set_false_path -to target_io4
set_false_path -to target_nRST
set_false_path -to target_poweron

# Not NewAE's, and measured on a Husky Plus rather than read from their
# constraints, which say nothing of it. The SAM3U launches the bus's
# strobes and address on the very edge of clk_usb that `usb_reg_main` must
# capture them on: caught a cycle late, `reg_read` rises a cycle late and
# the read data reaches the pins after NRD has risen. So each must reach its
# register before the clock does, and in SDC terms arrives a period (10.4)
# plus the SAM3U's clock to output after the edge before. Builds whose NRD
# reached `reg_read` 1.64, 2.95 and 3.49 ns ahead of its clock read their
# registers; one 0.19 ns behind it read nothing, and read once its input
# registers alone were moved beside their pads (2026-10-21). The margin
# is 3.0 ns, not the 2.0 first asked: at 2.0 the placer's wire estimate
# (0.035 ns a tile) allowed a register 27 tiles from its pad, and the
# routed estimate put one such connection, write data bit 7, at 3.68 ns
# and behind the clock, and that bit was the one written wrong. At 3.0 the
# budget is spent before any wire, and each register is held to the sites
# nearest its pad.
#
# The write data too, which was first left out on the reading that
# `reg_datao` takes it a cycle after NWE's rise is seen and so has time:
# the build with the strobes and address constrained wrote bit 1 as a one
# where a zero was written, in SAMPLES and SAD_THRESHOLD, and its bit 1
# reached `reg_datao` 4.27 ns behind the clock, the latest of the eight by
# 0.7 ns; the build placed before any of this, which also failed SAMPLES,
# had bit 1 the latest too. Every bit that arrived ahead of the clock was
# written right in every build.
set_input_delay -clock clk_usb 13.4 USB_RDn USB_WRn USB_ALEn USB_Addr USB_Data
