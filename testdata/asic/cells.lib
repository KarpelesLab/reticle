/*
 * A hand-written Liberty excerpt in the style of the SKY130 high-density
 * library (sky130_fd_sc_hd__tt_025C_1v80.lib). The numbers are plausible
 * but invented; the shapes of the groups are the ones a real open PDK
 * file uses: a units header, table templates, an inverter, a NAND2 with
 * state-dependent leakage, a tri-state buffer, a flip-flop with setup and
 * hold constraint tables, and a two-bit register with a bus pin.
 */
library (demo_sc_hd__tt_025C_1v80) {
  technology (cmos);
  delay_model : table_lookup;
  bus_naming_style : "%s[%d]";
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";
  capacitive_load_unit (1.0, pf);

  nom_process : 1.0;
  nom_temperature : 25.0;
  nom_voltage : 1.8;

  default_cell_leakage_power : 0.0;
  default_fanout_load : 1.0;
  default_max_transition : 1.5;
  default_input_pin_cap : 0.0;
  default_output_pin_cap : 0.0;

  operating_conditions (tt_025C_1v80) {
    process : 1.0;
    temperature : 25.0;
    voltage : 1.8;
    tree_type : balanced_tree;
  }
  default_operating_conditions : tt_025C_1v80;

  define (drive_type, pin, string);

  lu_table_template (del_1_7_7) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.01, 0.04, 0.16, 0.64");
    index_2 ("0.0005, 0.002, 0.008, 0.032");
  }
  lu_table_template (constraint_4x4) {
    variable_1 : related_pin_transition;
    variable_2 : constrained_pin_transition;
    index_1 ("0.01, 0.04, 0.16, 0.64");
    index_2 ("0.01, 0.04, 0.16, 0.64");
  }
  power_lut_template (pwr_4x4) {
    variable_1 : input_transition_time;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.01, 0.04, 0.16, 0.64");
    index_2 ("0.0005, 0.002, 0.008, 0.032");
  }

  type (bus2) {
    base_type : array;
    data_type : bit;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0;
    downto : true;
  }

  cell (demo_sc_hd__inv_1) {
    area : 3.7536;
    cell_footprint : "inv";
    cell_leakage_power : 0.0028;
    leakage_power () {
      when : "!A";
      value : 0.0015;
    }
    leakage_power () {
      when : "A";
      value : 0.0041;
    }
    pg_pin (VPWR) {
      pg_type : primary_power;
      voltage_name : "VPWR";
    }
    pg_pin (VGND) {
      pg_type : primary_ground;
      voltage_name : "VGND";
    }
    pin (A) {
      direction : input;
      capacitance : 0.0015;
      related_power_pin : "VPWR";
      related_ground_pin : "VGND";
      max_transition : 1.5;
      drive_type : "std";
    }
    pin (Y) {
      direction : output;
      function : "!A";
      power_down_function : "!VPWR + VGND";
      max_capacitance : 0.3;
      related_power_pin : "VPWR";
      related_ground_pin : "VGND";
      timing () {
        related_pin : "A";
        timing_sense : negative_unate;
        timing_type : combinational;
        cell_rise (del_1_7_7) {
          values ("0.021, 0.035, 0.079, 0.241", \
                  "0.028, 0.042, 0.086, 0.248", \
                  "0.046, 0.060, 0.104, 0.266", \
                  "0.099, 0.113, 0.157, 0.319");
        }
        cell_fall (del_1_7_7) {
          values ("0.019, 0.030, 0.066, 0.199", \
                  "0.025, 0.036, 0.072, 0.205", \
                  "0.041, 0.052, 0.088, 0.221", \
                  "0.088, 0.099, 0.135, 0.268");
        }
        rise_transition (del_1_7_7) {
          values ("0.014, 0.029, 0.086, 0.318", \
                  "0.015, 0.030, 0.087, 0.319", \
                  "0.019, 0.033, 0.090, 0.322", \
                  "0.033, 0.046, 0.101, 0.333");
        }
        fall_transition (del_1_7_7) {
          values ("0.012, 0.024, 0.070, 0.259", \
                  "0.013, 0.025, 0.071, 0.260", \
                  "0.016, 0.028, 0.073, 0.262", \
                  "0.027, 0.038, 0.082, 0.271");
        }
      }
      internal_power () {
        related_pin : "A";
        related_pg_pin : "VPWR";
        rise_power (pwr_4x4) {
          values ("0.0012, 0.0013, 0.0016, 0.0027", \
                  "0.0013, 0.0014, 0.0017, 0.0028", \
                  "0.0016, 0.0017, 0.0020, 0.0031", \
                  "0.0027, 0.0028, 0.0031, 0.0042");
        }
        fall_power (pwr_4x4) {
          values ("0.0010, 0.0011, 0.0014, 0.0025", \
                  "0.0011, 0.0012, 0.0015, 0.0026", \
                  "0.0014, 0.0015, 0.0018, 0.0029", \
                  "0.0025, 0.0026, 0.0029, 0.0040");
        }
      }
    }
  }

  cell (demo_sc_hd__nand2_1) {
    area : 5.0048;
    cell_footprint : "nand2";
    cell_leakage_power : 0.0037;
    leakage_power () {
      when : "!A & !B";
      value : 0.0011;
    }
    leakage_power () {
      when : "!A & B";
      value : 0.0026;
    }
    leakage_power () {
      when : "A & !B";
      value : 0.0031;
    }
    leakage_power () {
      when : "A & B";
      value : 0.0079;
    }
    pin (A) {
      direction : input;
      capacitance : 0.0017;
      max_transition : 1.5;
    }
    pin (B) {
      direction : input;
      capacitance : 0.0016;
      max_transition : 1.5;
    }
    pin (Y) {
      direction : output;
      function : "!(A&B)";
      max_capacitance : 0.3;
      timing () {
        related_pin : "A";
        timing_sense : negative_unate;
        when : "B";
        sdf_cond : "B == 1'b1";
        cell_rise (del_1_7_7) {
          values ("0.030, 0.045, 0.092, 0.262", \
                  "0.038, 0.053, 0.100, 0.270", \
                  "0.059, 0.074, 0.121, 0.291", \
                  "0.121, 0.136, 0.183, 0.353");
        }
        cell_fall (del_1_7_7) {
          values ("0.027, 0.039, 0.078, 0.221", \
                  "0.034, 0.046, 0.085, 0.228", \
                  "0.053, 0.065, 0.104, 0.247", \
                  "0.108, 0.120, 0.159, 0.302");
        }
        rise_transition (del_1_7_7) {
          values ("0.018, 0.034, 0.094, 0.335", \
                  "0.019, 0.035, 0.095, 0.336", \
                  "0.024, 0.039, 0.099, 0.340", \
                  "0.041, 0.055, 0.113, 0.353");
        }
        fall_transition (del_1_7_7) {
          values ("0.015, 0.028, 0.076, 0.271", \
                  "0.016, 0.029, 0.077, 0.272", \
                  "0.020, 0.032, 0.080, 0.275", \
                  "0.033, 0.044, 0.090, 0.285");
        }
      }
      timing () {
        related_pin : "B";
        timing_sense : negative_unate;
        when : "A";
        cell_rise (del_1_7_7) {
          values ("0.032, 0.047, 0.094, 0.264", \
                  "0.040, 0.055, 0.102, 0.272", \
                  "0.061, 0.076, 0.123, 0.293", \
                  "0.123, 0.138, 0.185, 0.355");
        }
        cell_fall (del_1_7_7) {
          values ("0.029, 0.041, 0.080, 0.223", \
                  "0.036, 0.048, 0.087, 0.230", \
                  "0.055, 0.067, 0.106, 0.249", \
                  "0.110, 0.122, 0.161, 0.304");
        }
      }
    }
  }

  cell (demo_sc_hd__einvn_1) {
    area : 8.7584;
    cell_footprint : "einvn";
    pin (A) {
      direction : input;
      capacitance : 0.0018;
    }
    pin (TE_B) {
      direction : input;
      capacitance : 0.0021;
    }
    pin (Z) {
      direction : output;
      function : "!A";
      three_state : "TE_B";
      max_capacitance : 0.3;
      timing () {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise (scalar) {
          values ("0.052");
        }
        cell_fall (scalar) {
          values ("0.047");
        }
      }
      timing () {
        related_pin : "TE_B";
        timing_type : three_state_enable;
        timing_sense : positive_unate;
        cell_rise (scalar) {
          values ("0.083");
        }
      }
      timing () {
        related_pin : "TE_B";
        timing_type : three_state_disable;
        timing_sense : negative_unate;
        cell_fall (scalar) {
          values ("0.061");
        }
      }
    }
  }

  cell (demo_sc_hd__dfrtp_1) {
    area : 20.0192;
    cell_footprint : "dfrtp";
    cell_leakage_power : 0.0105;
    ff (IQ, IQ_N) {
      next_state : "D";
      clocked_on : "CLK";
      clear : "!RESET_B";
    }
    pin (CLK) {
      direction : input;
      clock : true;
      capacitance : 0.0033;
      max_transition : 1.5;
      timing () {
        related_pin : "CLK";
        timing_type : min_pulse_width_high;
        rise_constraint (scalar) {
          values ("0.150");
        }
      }
    }
    pin (D) {
      direction : input;
      capacitance : 0.0021;
      timing () {
        related_pin : "CLK";
        timing_type : setup_rising;
        rise_constraint (constraint_4x4) {
          values ("0.060, 0.072, 0.108, 0.240", \
                  "0.066, 0.078, 0.114, 0.246", \
                  "0.084, 0.096, 0.132, 0.264", \
                  "0.138, 0.150, 0.186, 0.318");
        }
        fall_constraint (constraint_4x4) {
          values ("0.055, 0.067, 0.103, 0.235", \
                  "0.061, 0.073, 0.109, 0.241", \
                  "0.079, 0.091, 0.127, 0.259", \
                  "0.133, 0.145, 0.181, 0.313");
        }
      }
      timing () {
        related_pin : "CLK";
        timing_type : hold_rising;
        rise_constraint (constraint_4x4) {
          values ("-0.020, -0.026, -0.044, -0.098", \
                  "-0.014, -0.020, -0.038, -0.092", \
                  "0.004, -0.002, -0.020, -0.074", \
                  "0.058, 0.052, 0.034, -0.020");
        }
        fall_constraint (constraint_4x4) {
          values ("-0.018, -0.024, -0.042, -0.096", \
                  "-0.012, -0.018, -0.036, -0.090", \
                  "0.006, 0.000, -0.018, -0.072", \
                  "0.060, 0.054, 0.036, -0.018");
        }
      }
    }
    pin (RESET_B) {
      direction : input;
      capacitance : 0.0024;
      timing () {
        related_pin : "CLK";
        timing_type : recovery_rising;
        rise_constraint (scalar) {
          values ("0.085");
        }
      }
      timing () {
        related_pin : "CLK";
        timing_type : removal_rising;
        rise_constraint (scalar) {
          values ("-0.030");
        }
      }
    }
    pin (Q) {
      direction : output;
      function : "IQ";
      max_capacitance : 0.3;
      timing () {
        related_pin : "CLK";
        timing_type : rising_edge;
        timing_sense : non_unate;
        cell_rise (del_1_7_7) {
          values ("0.221, 0.235, 0.279, 0.441", \
                  "0.228, 0.242, 0.286, 0.448", \
                  "0.246, 0.260, 0.304, 0.466", \
                  "0.299, 0.313, 0.357, 0.519");
        }
        cell_fall (del_1_7_7) {
          values ("0.199, 0.210, 0.246, 0.379", \
                  "0.205, 0.216, 0.252, 0.385", \
                  "0.221, 0.232, 0.268, 0.401", \
                  "0.268, 0.279, 0.315, 0.448");
        }
      }
      timing () {
        related_pin : "RESET_B";
        timing_type : clear;
        timing_sense : positive_unate;
        cell_fall (scalar) {
          values ("0.172");
        }
      }
    }
  }

  cell (demo_sc_hd__dfrtp_2bit) {
    area : 38.4512;
    dont_use : true;
    dont_touch : true;
    ff_bank (IQ, IQ_N, 2) {
      next_state : "D";
      clocked_on : "CLK";
      clear : "!RESET_B";
    }
    pin (CLK) {
      direction : input;
      clock : true;
      capacitance : 0.0061;
    }
    pin (RESET_B) {
      direction : input;
      capacitance : 0.0044;
    }
    bus (D) {
      bus_type : bus2;
      direction : input;
      capacitance : 0.0021;
      pin (D[1]) {
        capacitance : 0.0023;
        timing () {
          related_pin : "CLK";
          timing_type : setup_rising;
          rise_constraint (scalar) {
            values ("0.064");
          }
        }
      }
      pin (D[0]) {
        timing () {
          related_pin : "CLK";
          timing_type : setup_rising;
          rise_constraint (scalar) {
            values ("0.062");
          }
        }
      }
    }
    bus (Q) {
      bus_type : bus2;
      direction : output;
      function : "IQ";
      max_capacitance : 0.3;
      pin (Q[1:0]) {
        timing () {
          related_pin : "CLK";
          timing_type : rising_edge;
          timing_sense : non_unate;
          cell_rise (scalar) {
            values ("0.238");
          }
          cell_fall (scalar) {
            values ("0.214");
          }
        }
      }
    }
    bundle (QN) {
      members (QN0, QN1);
      direction : output;
      function : "IQ_N";
      max_capacitance : 0.3;
    }
  }
}
