      related_power_pin : "VPWR";
      related_ground_pin : "VGND";
      timing () {
        related_pin : "A";
        timing_type : combinational;
        timing_sense : negative_unate;
        cell_rise (delay_4x4) {
          values ("0.0225, 0.0315, 0.0675, 0.2115", \
