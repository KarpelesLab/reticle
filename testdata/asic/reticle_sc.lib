/*
 * =====================================================================
 *  SYNTHETIC LIBRARY - THE NUMBERS IN THIS FILE ARE INVENTED.
 * =====================================================================
 *
 * `reticle_demo_sc` is a made-up standard-cell library written for
 * Reticle's own tests. No silicon was characterised for it: every area,
 * capacitance, delay and constraint below comes out of a first-order RC
 * model (delay = intrinsic + k * input_slew + R_drive * output_load)
 * with hand-picked constants, generated so that the tables are
 * internally consistent and monotonic, not so that they match any
 * process.
 *
 * DO NOT USE IT FOR ANYTHING REAL. Numbers from it say nothing about
 * area, timing or power on any process. For real results, point the flow
 * at a real PDK's Liberty file - SKY130
 * (sky130_fd_sc_hd__tt_025C_1v80.lib) and IHP SG13G2
 * (sg13g2_stdcell_typ_1p20V_25C.lib) both load unchanged; see
 * docs/asic.md.
 *
 * What is modelled here is the *shape* of an open-PDK library, because
 * that is what the reader and the mapper are tested against:
 *
 *   - a units header, `delay_model : table_lookup`, operating conditions
 *     and library-level defaults;
 *   - 2-D `lu_table_template` delay and constraint tables indexed by
 *     input transition and output capacitance;
 *   - combinational cells in several drive strengths, each with per-pin
 *     timing arcs, pin capacitances and a `max_capacitance`;
 *   - flip-flops with `ff` groups: plain, negative edge, asynchronous
 *     active-low reset and set, and a clock enable written the way a
 *     real library writes it, as `next_state : "(D & E) + (IQ & !E)"`;
 *   - cells the mapper must refuse: a tri-state buffer, a multi-output
 *     full adder, a 6-input multiplexer beyond the truth-table width
 *     limit, a `dont_use` delay cell and two physical-only cells.
 */
library (reticle_demo_sc_tt_025C_1v80) {
  technology (cmos);
  delay_model : table_lookup;
  bus_naming_style : "%s[%d]";
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";
  capacitive_load_unit (1.0, pf);

  nom_process : 1.0;
  nom_temperature : 25.0;
  nom_voltage : 1.8;

  default_cell_leakage_power : 0.0;
  default_fanout_load : 1.0;
  default_max_transition : 1.5;
  default_max_capacitance : 0.06;
  default_input_pin_cap : 0.0;
  default_output_pin_cap : 0.0;

  operating_conditions (tt_025C_1v80) {
    process : 1.0;
    temperature : 25.0;
    voltage : 1.8;
    tree_type : balanced_tree;
  }
  default_operating_conditions : tt_025C_1v80;

  lu_table_template (delay_4x4) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.01, 0.04, 0.16, 0.64");
    index_2 ("0.0005, 0.002, 0.008, 0.032");
  }
  lu_table_template (constraint_4x4) {
    variable_1 : related_pin_transition;
    variable_2 : constrained_pin_transition;
    index_1 ("0.01, 0.04, 0.16, 0.64");
    index_2 ("0.01, 0.04, 0.16, 0.64");
  }

