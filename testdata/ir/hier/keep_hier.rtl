// Two instances of one module, one of them marked `keep_hierarchy`.
top top

module core
  net %a u4 wire
  net %y u4 wire
  port a in %a
  port y out %y
  assign %y = not(%a)
end

module top
  net %x u4 wire
  net %o0 u4 wire
  net %o1 u4 wire
  port x in %x
  port o0 out %o0
  port o1 out %o1
  attr keep_hierarchy = 1
  instance u_keep of core (a=%x, y=%o0)
  instance u_flat of core (a=%x, y=%o1)
end
