top top

module split
  net %d u8 wire
  net %hi u4 wire
  net %lo u4 wire
  port d in %d
  port hi out %hi
  port lo out %lo
  assign %hi = %d[7:4]
  assign %lo = %d[3:0]
end

module top
  net %din u8 wire
  net %a u4 wire
  net %b u8 wire
  net %"u0.hi" u4 wire
  net %"u0.lo" u4 wire
  port din in %din
  port a out %a
  port b out %b
  assign %"u0.hi" = %din[7:4]
  assign %"u0.lo" = %din[3:0]
  assign {%a[3:2], %a[1:0]} = %"u0.hi"
  assign %b[3:0] = %"u0.lo"
end
