--- diagnostics
error: invalid digit `2` in binary literal
 --> errors.v:3:14
  |
3 |     wire a = 4'b102;
  |              ^^^^^^

error: hexadecimal literal has no digits
 --> errors.v:4:14
  |
4 |     wire b = 8'h;
  |              ^^^

error: decimal literal may be a single `x` or `z`, not mixed with digits
 --> errors.v:5:14
  |
5 |     wire c = 3'd1x;
  |              ^^^^^

error: invalid digit `9` in octal literal
 --> errors.v:6:14
  |
6 |     wire d = 8'o9;
  |              ^^^^

error: unterminated string literal
 --> errors.v:8:14
  |
8 |     wire e = "open
  |              ^^^^^

error: unknown escape sequence `\q`
 --> errors.v:9:19
  |
9 |     wire f = "bad \q escape";
  |                   ^^

error: octal escape exceeds \377
  --> errors.v:10:29
   |
10 |     wire g = "octal too big \777";
   |                             ^^^^

error: `\x` escape needs hex digits
  --> errors.v:11:32
   |
11 |     wire h = "hex needs digits \x";
   |                                ^^

error: unexpected character `§`
  --> errors.v:13:16
   |
13 |     wire i = a § b;
   |                ^

error: escaped identifier has no characters
  --> errors.v:14:14
   |
14 |     wire j = \ ;
   |              ^

error: undefined macro `UNDEFINED`
  --> errors.v:16:14
   |
16 |     wire k = `UNDEFINED;
   |              ^^^^^^^^^^

error: undefined macro `MACRO_WITH_ARGS`
  --> errors.v:17:5
   |
17 |     `MACRO_WITH_ARGS(1)
   |     ^^^^^^^^^^^^^^^^

error: macro `F` takes 2 argument(s) but 1 were given
  --> errors.v:19:14
   |
19 |     wire l = `F(1);
   |              ^^^^^

error: macro `F` takes 2 argument(s) but 3 were given
  --> errors.v:20:14
   |
20 |     wire m = `F(1, 2, 3);
   |              ^^^^^^^^^^^

error: macro `F` takes arguments but none were given
  --> errors.v:21:14
   |
21 |     wire n = `F;
   |              ^^

error: recursive expansion of macro `R`
  --> errors.v:23:14
   |
23 |     wire o = `R;
   |              ^^

error: recursive expansion of macro `S`
  --> errors.v:26:14
   |
26 |     wire p = `S;
   |              ^^

error: `` `endif `` without a matching `` `ifdef ``
  --> errors.v:27:5
   |
27 |     `endif
   |     ^^^^^^

error: `` `else `` without a matching `` `ifdef ``
  --> errors.v:28:5
   |
28 |     `else
   |     ^^^^^

error: cannot find include file `missing.vh`
  --> errors.v:29:5
   |
29 |     `include "missing.vh"
   |     ^^^^^^^^^^^^^^^^^^^^^

error: expected a quoted file name after `` `include ``
  --> errors.v:30:5
   |
30 |     `include nope
   |     ^^^^^^^^^

error: expected a macro name after the directive
  --> errors.v:31:5
   |
31 |     `define
   |     ^^^^^^^

error: expected a macro name after the directive
  --> errors.v:32:5
   |
32 |     `define 9x
   |     ^^^^^^^^

error: expected a macro name after the directive
  --> errors.v:33:5
   |
33 |     `ifdef
   |     ^^^^^^

error: duplicate `` `else ``
  --> errors.v:35:20
   |
35 |     `ifdef X `else `else `endif
   |                    ^^^^^

error: `` `elsif `` after `` `else ``
  --> errors.v:36:30
   |
36 |     `ifndef X `elsif Y `else `elsif Z `endif
   |                              ^^^^^^

error: unterminated string literal
  --> errors.v:37:14
   |
37 |     wire q = "unterminated string, then an unterminated conditional
