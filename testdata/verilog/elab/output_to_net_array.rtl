top output_to_net_array

module ona_inv
  net %a u4 wire
  net %y u4 wire
  port a in %a
  port y out %y
  assign %y = not(%a)
end

module output_to_net_array
  net %a u4 wire
  net %y0 u4 wire
  net %y1 u4 wire
  net %y_out$1 u4 wire
  net %y_out$2 u4 wire
  port a in %a
  port y0 out %y0
  port y1 out %y1
  memory @d 2 x u4
  instance u0 of ona_inv (a=%a, y=%y_out$1)
  instance u1 of ona_inv (a=not(%a), y=%y_out$2)
  assign @d[32'sd0] = %y_out$1
  assign @d[32'sd1] = %y_out$2
  assign %y0 = @d[32'sd0]
  assign %y1 = @d[32'sd1]
end
