top casez_decoder

module casez_decoder
  net %req u4 wire
  net %grant u2 reg
  net %valid u1 reg
  port req in %req
  port grant out %grant
  port valid out %valid
  process comb
    %valid = 1'd1
    casez %req
      when 4'b1zzz
        %grant = 2'd3
      end
      when 4'b01zz
        %grant = 2'd2
      end
      when 4'b001z
        %grant = 2'd1
      end
      when 4'd1
        %grant = 2'd0
      end
      default
        %grant = 2'd0
        %valid = 1'd0
      end
    end
  end
end
