// Several drivers on one wire: conflicts give x, z yields, and slices of one
// net can be driven separately.
top wires

module wires
  net %a u1 reg
  net %b u1 reg
  net %y u1 wire
  net %y2 u1 wire
  net %w u8 wire
  net %bus u4 wire
  net %da u4 reg
  net %db u4 reg
  net %ena u1 reg
  net %enb u1 reg
  assign %y = %a
  assign %y = %b
  assign %y2 = %a
  assign %y2 = 1'bz
  assign %w[3:0] = 4'ha
  assign %w[7:4] = 4'h5
  cell t0 tristate (a=%da, en=%ena) -> (y=%bus)
  cell t1 tristate (a=%db, en=%enb) -> (y=%bus)
  process initial
    %a = 1'd1
    %b = 1'd0
    %da = 4'h3
    %db = 4'hc
    %ena = 1'd1
    %enb = 1'd0
    wait for 8'd1
    sys $display("y=%b y2=%b w=%h bus=%h", %y, %y2, %w, %bus)
    %b = 1'd1
    %enb = 1'd1
    wait for 8'd1
    sys $display("y=%b y2=%b w=%h bus=%h", %y, %y2, %w, %bus)
    %ena = 1'd0
    wait for 8'd1
    sys $display("y=%b y2=%b w=%h bus=%h", %y, %y2, %w, %bus)
  end
end
