// A small clocked design whose waveform is compared against a golden VCD.
top wave

module wave
  timescale 1 ns / 1 ns
  net %clk u1 reg
  net %q u2 reg
  net %nq u2 wire
  assign %nq = not(%q)
  process clkgen free
    wait for 8'd5
    %clk = not(%clk)
  end
  process seq posedge %clk
    %q <= add(%q, 2'd1)
  end
  process initial
    %clk = 1'd0
    %q = 2'd0
    wait for 8'd22
    finish
  end
end
