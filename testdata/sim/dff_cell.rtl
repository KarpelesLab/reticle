// A counter in cell form: an adder, a mux and a D flip-flop with an
// asynchronous reset, driven by a behavioural testbench.
top cells_tb

module cells_tb
  timescale 1 ns / 1 ps
  net %clk u1 reg
  net %rst u1 reg
  net %en u1 reg
  net %q u4 wire
  net %inc u4 wire
  net %q_next u4 wire
  net %is2 u1 wire
  cell add0 add (a=%q, b=4'd1) -> (y=%inc)
  cell mux0 mux (a=%q, b=%inc, s=%en) -> (y=%q_next)
  cell ff0 dff pos arst pos 4'd0 (clk=%clk, d=%q_next, rst=%rst) -> (q=%q)
  cell eq0 eq (a=%q, b=4'd2) -> (y=%is2)
  process clkgen free
    wait for 8'd5
    %clk = not(%clk)
  end
  process stim initial
    %clk = 1'd0
    %en = 1'd1
    %rst = 1'd1
    wait for 8'd12
    %rst = 1'd0
    wait for 8'd15
    sys $display("q=%0d is2=%b", %q, %is2)
    wait for 8'd11
    sys $display("q=%0d is2=%b", %q, %is2)
    %rst = 1'd1
    wait for 8'd1
    sys $display("async reset: q=%0d", %q)
    %rst = 1'd0
    %en = 1'd0
    wait for 8'd10
    sys $display("held: q=%0d", %q)
    finish
  end
end
