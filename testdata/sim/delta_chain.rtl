// A chain of continuous assignments settles within one time slot through
// successive delta cycles; the comb process sees the settled values.
top chain

module chain
  net %a u1 reg
  net %b u1 wire
  net %c u1 wire
  net %d u1 wire
  net %e u1 reg
  assign %b = not(%a)
  assign %c = not(%b)
  assign %d = not(%c)
  process comb
    %e = xor(%d, %a)
  end
  process initial
    %a = 1'd0
    wait for 8'd1
    sys $display("a=%b b=%b c=%b d=%b e=%b", %a, %b, %c, %d, %e)
    %a = 1'd1
    wait for 8'd1
    sys $display("a=%b b=%b c=%b d=%b e=%b", %a, %b, %c, %d, %e)
  end
end
