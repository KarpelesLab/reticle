> ask 3 textDocument/prepareRename file:///counter.v 2 7
< {
    "jsonrpc": "2.0",
    "id": 3,
    "result": null
  }

> ask 4 textDocument/rename file:///counter.v 2 7 {"newName":"ctr"}
< {
    "jsonrpc": "2.0",
    "id": 4,
    "error": {
      "code": -32803,
      "message": "`counter` is a module name, which other files of the design may use; the server only sees the documents you have open, so it cannot rename it everywhere"
    }
  }

