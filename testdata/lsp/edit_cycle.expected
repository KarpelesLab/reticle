> notify initialized {}

> open file:///counter.v verilog counter.v
< {
    "jsonrpc": "2.0",
    "method": "textDocument/publishDiagnostics",
    "params": {
      "uri": "file:///counter.v",
      "version": 1,
      "diagnostics": []
    }
  }

> edit file:///counter.v 2 9 16 9 17 "("
< {
    "jsonrpc": "2.0",
    "method": "textDocument/publishDiagnostics",
    "params": {
      "uri": "file:///counter.v",
      "version": 2,
      "diagnostics": [
        {
          "range": {
            "start": {
              "line": 9,
              "character": 24
