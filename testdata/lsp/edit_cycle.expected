> request 1 initialize {}
< {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "capabilities": {
        "positionEncoding": "utf-16",
        "textDocumentSync": {
          "openClose": true,
          "change": 2,
          "save": {
            "includeText": false
          }
