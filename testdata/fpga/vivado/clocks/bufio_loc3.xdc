set_property IOSTANDARD LVCMOS33 [get_ports si]
set_property PACKAGE_PIN L5 [get_ports so]
set_property IOSTANDARD LVCMOS33 [get_ports so]
set_property PACKAGE_PIN N14 [get_ports clk2]
set_property IOSTANDARD LVCMOS33 [get_ports clk2]
set_property PACKAGE_PIN T9 [get_ports q_pad]
set_property IOSTANDARD LVCMOS33 [get_ports q_pad]
set_property LOC BUFIO_X0Y7 [get_cells dut]
