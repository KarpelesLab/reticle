create_clock -period 10 -name clk [get_ports clk]
set_property PACKAGE_PIN N11 [get_ports clk]
set_property IOSTANDARD LVCMOS33 [get_ports clk]
set_property PACKAGE_PIN L4 [get_ports si]
set_property IOSTANDARD LVCMOS33 [get_ports si]
set_property PACKAGE_PIN L5 [get_ports so]
set_property IOSTANDARD LVCMOS33 [get_ports so]
set_property BITSTREAM.CONFIG.USERID 0xDEADBEEF [current_design]
set_property BITSTREAM.STARTUP.DONE_CYCLE 6 [current_design]
set_property BITSTREAM.STARTUP.GTS_CYCLE 4 [current_design]
set_property BITSTREAM.CONFIG.SPI_FALL_EDGE YES [current_design]
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 2 [current_design]
set_property BITSTREAM.CONFIG.SPI_32BIT_ADDR YES [current_design]
set_property BITSTREAM.CONFIG.CONFIGFALLBACK ENABLE [current_design]
set_property BITSTREAM.CONFIG.NEXT_CONFIG_ADDR 0x00400000 [current_design]
set_property BITSTREAM.CONFIG.TIMER_CFG 0x00001234 [current_design]
set_property BITSTREAM.GENERAL.JTAG_XADC DISABLE [current_design]
set_property BITSTREAM.CONFIG.M0PIN PULLNONE [current_design]
