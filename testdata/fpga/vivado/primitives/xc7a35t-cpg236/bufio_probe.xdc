create_clock -period 10 -name clk [get_ports clk]
set_property PACKAGE_PIN N17 [get_ports clk]
set_property PACKAGE_PIN R2 [get_ports si]
set_property PACKAGE_PIN U1 [get_ports so]
set_property IOSTANDARD LVCMOS33 [get_ports {clk si so}]
set_property PACKAGE_PIN L17 [get_ports i_pad]
set_property IOSTANDARD LVCMOS33 [get_ports i_pad]
set_property PACKAGE_PIN P17 [get_ports d_pad]
set_property IOSTANDARD LVCMOS33 [get_ports d_pad]
