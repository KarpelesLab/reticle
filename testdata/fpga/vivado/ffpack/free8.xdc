create_clock -period 4 -name clk [get_ports clk]
set_property PACKAGE_PIN N11 [get_ports clk]
set_property PACKAGE_PIN L4 [get_ports {d[0]}]
set_property PACKAGE_PIN N3 [get_ports {q[0]}]
set_property PACKAGE_PIN L5 [get_ports {d[1]}]
set_property PACKAGE_PIN P1 [get_ports {q[1]}]
set_property PACKAGE_PIN M1 [get_ports {d[2]}]
set_property PACKAGE_PIN P3 [get_ports {q[2]}]
set_property PACKAGE_PIN M2 [get_ports {d[3]}]
set_property PACKAGE_PIN P4 [get_ports {q[3]}]
set_property PACKAGE_PIN M4 [get_ports {d[4]}]
set_property PACKAGE_PIN P5 [get_ports {q[4]}]
set_property PACKAGE_PIN M5 [get_ports {d[5]}]
set_property PACKAGE_PIN R1 [get_ports {q[5]}]
set_property PACKAGE_PIN N1 [get_ports {d[6]}]
set_property PACKAGE_PIN R2 [get_ports {q[6]}]
set_property PACKAGE_PIN N2 [get_ports {d[7]}]
set_property PACKAGE_PIN R3 [get_ports {q[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports *]
set_property IOB FALSE [get_cells -hier -filter {REF_NAME =~ FD*}]
set_property BEL AFF [get_cells r0]
set_property LOC SLICE_X4Y50 [get_cells r0]
set_property BEL A5FF [get_cells r1]
set_property LOC SLICE_X4Y50 [get_cells r1]
set_property BEL BFF [get_cells r2]
set_property LOC SLICE_X4Y50 [get_cells r2]
set_property BEL B5FF [get_cells r3]
set_property LOC SLICE_X4Y50 [get_cells r3]
set_property BEL CFF [get_cells r4]
set_property LOC SLICE_X4Y50 [get_cells r4]
set_property BEL C5FF [get_cells r5]
set_property LOC SLICE_X4Y50 [get_cells r5]
set_property BEL DFF [get_cells r6]
set_property LOC SLICE_X4Y50 [get_cells r6]
set_property BEL D5FF [get_cells r7]
set_property LOC SLICE_X4Y50 [get_cells r7]
