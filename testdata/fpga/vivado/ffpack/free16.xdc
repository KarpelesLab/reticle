create_clock -period 4 -name clk [get_ports clk]
set_property PACKAGE_PIN N11 [get_ports clk]
set_property PACKAGE_PIN L4 [get_ports {si}]
set_property PACKAGE_PIN L5 [get_ports {q[0]}]
set_property PACKAGE_PIN M1 [get_ports {q[1]}]
set_property PACKAGE_PIN M2 [get_ports {q[2]}]
set_property PACKAGE_PIN M4 [get_ports {q[3]}]
set_property PACKAGE_PIN M5 [get_ports {q[4]}]
set_property PACKAGE_PIN N1 [get_ports {q[5]}]
set_property PACKAGE_PIN N2 [get_ports {q[6]}]
set_property PACKAGE_PIN N3 [get_ports {q[7]}]
set_property PACKAGE_PIN P1 [get_ports {q[8]}]
set_property PACKAGE_PIN P3 [get_ports {q[9]}]
set_property PACKAGE_PIN P4 [get_ports {q[10]}]
set_property PACKAGE_PIN P5 [get_ports {q[11]}]
set_property PACKAGE_PIN R1 [get_ports {q[12]}]
set_property PACKAGE_PIN R2 [get_ports {q[13]}]
set_property PACKAGE_PIN R3 [get_ports {q[14]}]
set_property PACKAGE_PIN A2 [get_ports {q[15]}]
set_property IOSTANDARD LVCMOS33 [get_ports *]
set_property IOB FALSE [get_cells -hier -filter {REF_NAME =~ FD*}]
set_property LOC SLICE_X4Y50 [get_cells r0]
set_property LOC SLICE_X4Y50 [get_cells r1]
set_property LOC SLICE_X4Y50 [get_cells r2]
set_property LOC SLICE_X4Y50 [get_cells r3]
set_property LOC SLICE_X4Y50 [get_cells r4]
set_property LOC SLICE_X4Y50 [get_cells r5]
set_property LOC SLICE_X4Y50 [get_cells r6]
set_property LOC SLICE_X4Y50 [get_cells r7]
set_property LOC SLICE_X5Y50 [get_cells r8]
set_property LOC SLICE_X5Y50 [get_cells r9]
set_property LOC SLICE_X5Y50 [get_cells r10]
set_property LOC SLICE_X5Y50 [get_cells r11]
set_property LOC SLICE_X5Y50 [get_cells r12]
set_property LOC SLICE_X5Y50 [get_cells r13]
set_property LOC SLICE_X5Y50 [get_cells r14]
set_property LOC SLICE_X5Y50 [get_cells r15]
