port a[0] IN pin= iostandard=LVCMOS18 drive= slew= pulltype=
port a[1] IN pin= iostandard=LVCMOS18 drive= slew= pulltype=
port a[2] IN pin= iostandard=LVCMOS18 drive= slew= pulltype=
port a[3] IN pin= iostandard=LVCMOS18 drive= slew= pulltype=
port be[0] IN pin= iostandard=LVCMOS18 drive= slew= pulltype=
port be[1] IN pin= iostandard=LVCMOS18 drive= slew= pulltype=
port be[2] IN pin= iostandard=LVCMOS18 drive= slew= pulltype=
port be[3] IN pin= iostandard=LVCMOS18 drive= slew= pulltype=
port clk IN pin= iostandard=LVCMOS18 drive= slew= pulltype=
port clk2 IN pin= iostandard=LVCMOS18 drive= slew= pulltype=
port hi[4] IN pin= iostandard=LVCMOS18 drive= slew= pulltype=
port hi[5] IN pin= iostandard=LVCMOS18 drive= slew= pulltype=
port hi[6] IN pin= iostandard=LVCMOS18 drive= slew= pulltype=
port hi[7] IN pin= iostandard=LVCMOS18 drive= slew= pulltype=
port io1 INOUT pin= iostandard=LVCMOS18 drive=12 slew=SLOW pulltype=
port q[0] OUT pin= iostandard=LVCMOS18 drive=12 slew=SLOW pulltype=
port q[1] OUT pin= iostandard=LVCMOS18 drive=12 slew=SLOW pulltype=
port q[2] OUT pin= iostandard=LVCMOS18 drive=12 slew=SLOW pulltype=
port q[3] OUT pin= iostandard=LVCMOS18 drive=12 slew=SLOW pulltype=
port rst IN pin= iostandard=LVCMOS18 drive= slew= pulltype=
port single IN pin= iostandard=LVCMOS18 drive= slew= pulltype=
port so OUT pin= iostandard=LVCMOS18 drive=12 slew=SLOW pulltype=
port y0 OUT pin= iostandard=LVCMOS18 drive=12 slew=SLOW pulltype=
port y1 OUT pin= iostandard=LVCMOS18 drive=12 slew=SLOW pulltype=
port y2 OUT pin= iostandard=LVCMOS18 drive=12 slew=SLOW pulltype=
port y3 OUT pin= iostandard=LVCMOS18 drive=12 slew=SLOW pulltype=
clock c2 period=7.000 waveform=0.000,3.500 generated=0 user=0 virtual=0 sources=clk2
clock clk period=10.000 waveform=0.000,5.000 generated=0 user=0 virtual=0 sources=clk
clock clk_mmcm period=5.000 waveform=0.000,2.500 generated=1 user=0 virtual=0 sources=u_mmcm/CLKOUT0
clock feedback period=10.000 waveform=0.000,5.000 generated=1 user=0 virtual=0 sources=u_mmcm/CLKFBOUT
timing set_false_path -from port:rst
timing set_false_path -to port:so
timing set_false_path -from port:a[0],port:a[1] -to cell:m_reg
timing set_false_path -from cell:t_reg[4],cell:t_reg[5],cell:t_reg[6],cell:t_reg[7]
timing set_false_path -from clock:clk -to clock:c2
timing set_false_path -through pin:u_sub/q
timing set_false_path -through net:u_sub/q -to port:y0
timing set_false_path -from pin:r_reg[0]/C -to pin:r_reg[1]/D
timing set_false_path -from cell:u_sub/s1_reg
timing set_false_path -from port:single
timing set_false_path -to cell:div_reg[0]
timing set_false_path -from port:clk2
timing set_false_path -from clock:clk
timing set_false_path -setup -from port:a[2]
timing set_false_path -hold -to port:y1
timing set_multicycle_path -from cell:r_reg[2] -to cell:r_reg[3] 2
timing set_multicycle_path -setup -to cell:t_reg[4] 3
timing set_multicycle_path -hold -to cell:t_reg[4] 2
timing set_multicycle_path -setup -from cell:div_reg[1] 4
timing set_multicycle_path -setup -start -from clock:clk -to clock:c2 2
timing set_multicycle_path -hold -end -from clock:clk -to clock:c2 1
timing set_max_delay -from cell:q_reg[0] 3.000
timing set_max_delay -to cell:q_reg[1] 3.000
timing set_max_delay -from cell:q_reg[2] -to cell:q_reg[3] 4.000
timing set_max_delay -datapath_only -from cell:u_sub/q_reg 6.000
timing set_max_delay -datapath_only -from clock:c2 -to clock:clk 5.000
timing set_max_delay -through pin:u_sub/s1_reg/D 3.000
timing set_min_delay -from cell:clk_div_reg 1.000
timing set_clock_groups -asynchronous -group clock:clk -group clock:c2
timing set_clock_groups -asynchronous -group clock:clk -group clock:c2
timing set_clock_groups -name named -logically_exclusive -group clock:clk -group clock:c2
timing set_clock_groups -physically_exclusive -group clock:clk -group clock:c2
