top pllshift

module pllshift
  net %clk u1 wire
  attr clock_mhz = 125
  net %sys u1 wire
  net %q u1 wire
  net %sr u8 wire
  net %next u8 wire
  net %clk$pad u1 wire
  net %clk$in0 u1 wire
  net %d$pad u1 wire
  net %d$in0 u1 wire
  net %q$pad u1 wire
  net %q$pin0 u1 wire
  net %sys$gb u1 wire
  net %sr$q0 u1 wire
  net %sr$q1 u1 wire
  net %sr$q2 u1 wire
  net %sr$q3 u1 wire
  net %sr$q4 u1 wire
  net %sr$q5 u1 wire
  net %sr$q6 u1 wire
  net %sr$q7 u1 wire
  port clk in %clk$pad
  port d in %d$pad
  port q out %q$pad
  assign %clk = %clk$in0
  assign %q = %sr[7:7]
  assign %next = {%sr[6:6], %sr[5:5], %sr[4:4], %sr[3:3], %sr[2:2], %sr[1:1], %sr[0:0], %d$in0}
  assign %q$pad = %q$pin0
  assign %sr = {%sr$q7, %sr$q6, %sr$q5, %sr$q4, %sr$q3, %sr$q2, %sr$q1, %sr$q0}
  attr port = "clk"
  attr pin = "G2"
  attr io_standard = "LVCMOS33"
  cell clk$io0 blackbox TRELLIS_IO #(DIR="INPUT") (B=%clk$pad) -> (O=%clk$in0)
  attr port = "d"
  cell d$io0 blackbox TRELLIS_IO #(DIR="INPUT") (B=%d$pad) -> (O=%d$in0)
  attr port = "q"
  cell q$io0 blackbox TRELLIS_IO #(DIR="OUTPUT") (I=%q) -> (B=%q$pin0)
  attr frequency_mhz = "125.000000"
  cell sys$pll blackbox EHXPLLL #(PLLRST_ENA="DISABLED", INTFB_WAKE="DISABLED", STDBY_ENABLE="DISABLED", DPHASE_SOURCE="DISABLED", OUTDIVIDER_MUXA="DIVA", OUTDIVIDER_MUXB="DIVB", OUTDIVIDER_MUXC="DIVC", OUTDIVIDER_MUXD="DIVD", CLKOP_ENABLE="ENABLED", CLKOP_FPHASE=0, FEEDBK_PATH="CLKOP", CLKI_DIV=1, CLKFB_DIV=5, CLKOP_DIV=4, CLKOP_CPHASE=3) (CLKI=%clk, CLKFB=%sys, RST=1'd0, STDBY=1'd0, PHASESEL0=1'd0, PHASESEL1=1'd0, PHASEDIR=1'd0, PHASESTEP=1'd0, PHASELOADREG=1'd0, PLLWAKESYNC=1'd0, ENCLKOP=1'd0) -> (CLKOP=%sys)
  cell sys$gbuf blackbox DCCA (CLKI=%sys, CE=1'd1) -> (CLKO=%sys$gb)
  cell sr$ff0 blackbox TRELLIS_FF #(GSR="DISABLED", REGMODE="FF", CEMUX=1, CLKMUX="CLK", LSRMUX="LSR", SRMODE="LSR_OVER_CE", REGSET="RESET") (CLK=%sys$gb, DI=%next[0:0], CE=1'd1, LSR=1'd0) -> (Q=%sr$q0)
  cell sr$ff1 blackbox TRELLIS_FF #(GSR="DISABLED", REGMODE="FF", CEMUX=1, CLKMUX="CLK", LSRMUX="LSR", SRMODE="LSR_OVER_CE", REGSET="RESET") (CLK=%sys$gb, DI=%next[1:1], CE=1'd1, LSR=1'd0) -> (Q=%sr$q1)
  cell sr$ff2 blackbox TRELLIS_FF #(GSR="DISABLED", REGMODE="FF", CEMUX=1, CLKMUX="CLK", LSRMUX="LSR", SRMODE="LSR_OVER_CE", REGSET="RESET") (CLK=%sys$gb, DI=%next[2:2], CE=1'd1, LSR=1'd0) -> (Q=%sr$q2)
  cell sr$ff3 blackbox TRELLIS_FF #(GSR="DISABLED", REGMODE="FF", CEMUX=1, CLKMUX="CLK", LSRMUX="LSR", SRMODE="LSR_OVER_CE", REGSET="RESET") (CLK=%sys$gb, DI=%next[3:3], CE=1'd1, LSR=1'd0) -> (Q=%sr$q3)
  cell sr$ff4 blackbox TRELLIS_FF #(GSR="DISABLED", REGMODE="FF", CEMUX=1, CLKMUX="CLK", LSRMUX="LSR", SRMODE="LSR_OVER_CE", REGSET="RESET") (CLK=%sys$gb, DI=%next[4:4], CE=1'd1, LSR=1'd0) -> (Q=%sr$q4)
  cell sr$ff5 blackbox TRELLIS_FF #(GSR="DISABLED", REGMODE="FF", CEMUX=1, CLKMUX="CLK", LSRMUX="LSR", SRMODE="LSR_OVER_CE", REGSET="RESET") (CLK=%sys$gb, DI=%next[5:5], CE=1'd1, LSR=1'd0) -> (Q=%sr$q5)
  cell sr$ff6 blackbox TRELLIS_FF #(GSR="DISABLED", REGMODE="FF", CEMUX=1, CLKMUX="CLK", LSRMUX="LSR", SRMODE="LSR_OVER_CE", REGSET="RESET") (CLK=%sys$gb, DI=%next[6:6], CE=1'd1, LSR=1'd0) -> (Q=%sr$q6)
  cell sr$ff7 blackbox TRELLIS_FF #(GSR="DISABLED", REGMODE="FF", CEMUX=1, CLKMUX="CLK", LSRMUX="LSR", SRMODE="LSR_OVER_CE", REGSET="RESET") (CLK=%sys$gb, DI=%next[7:7], CE=1'd1, LSR=1'd0) -> (Q=%sr$q7)
end
