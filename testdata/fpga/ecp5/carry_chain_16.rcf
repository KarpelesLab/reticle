# Every port of `testdata/fpga/ecp5/carry_chain_16.v` on a top-edge ball
# of an LFE5U-12F in caBGA-256, in the order Project Trellis' own
# `iodb.json` lists them across the die: column ascending, PIO A before
# PIO B. Nothing here is about a board — no board has this design on it —
# and the only thing that matters about the assignment is that it is
# fixed, so that the placement the test measures is the same on every run.
#
# The top edge is the one this backend describes with two PIOs a position
# (56 balls of the package are on it), and bank 1's rail is 3.3 V, hence
# LVCMOS33 throughout. See `docs/fpga-trellis.md`.
#
# `clk` is first on purpose: it is the one signal that has to leave its pad
# through a clock buffer and travel the global network, and the test
# asserts that it did.

set_io -io_standard LVCMOS33 clk A2
set_io -io_standard LVCMOS33 rst_n B3
set_io -io_standard LVCMOS33 step[0] A3
set_io -io_standard LVCMOS33 step[1] A4
set_io -io_standard LVCMOS33 step[2] E4
set_io -io_standard LVCMOS33 step[3] D4
set_io -io_standard LVCMOS33 step[4] C4
set_io -io_standard LVCMOS33 step[5] B4
set_io -io_standard LVCMOS33 step[6] E5
set_io -io_standard LVCMOS33 step[7] D5
set_io -io_standard LVCMOS33 step[8] C5
set_io -io_standard LVCMOS33 step[9] B5
set_io -io_standard LVCMOS33 step[10] A5
set_io -io_standard LVCMOS33 step[11] A6
set_io -io_standard LVCMOS33 step[12] E6
set_io -io_standard LVCMOS33 step[13] D6
set_io -io_standard LVCMOS33 step[14] C6
set_io -io_standard LVCMOS33 step[15] B6
set_io -io_standard LVCMOS33 total[0] E7
set_io -io_standard LVCMOS33 total[1] D7
set_io -io_standard LVCMOS33 total[2] C7
set_io -io_standard LVCMOS33 total[3] B7
set_io -io_standard LVCMOS33 total[4] A7
set_io -io_standard LVCMOS33 total[5] A8
set_io -io_standard LVCMOS33 total[6] E8
set_io -io_standard LVCMOS33 total[7] D8
set_io -io_standard LVCMOS33 total[8] C8
set_io -io_standard LVCMOS33 total[9] B8
set_io -io_standard LVCMOS33 total[10] B9
set_io -io_standard LVCMOS33 total[11] C9
set_io -io_standard LVCMOS33 total[12] D9
set_io -io_standard LVCMOS33 total[13] E9
set_io -io_standard LVCMOS33 total[14] A9
set_io -io_standard LVCMOS33 total[15] A10
