top ram16

module ram16
  net %clk u1 wire
  net %we u1 wire
  net %waddr u4 wire
  net %raddr u4 wire
  net %wdata u8 wire
  net %rdata u8 wire
  port clk in %clk
  port we in %we
  port waddr in %waddr
  port raddr in %raddr
  port wdata in %wdata
  port rdata out %rdata
  memory @mem 16 x u8
  cell wr memwr @mem clocked (addr=%waddr, data=%wdata, en=%we, clk=%clk) -> ()
  cell rd memrd @mem (addr=%raddr) -> (data=%rdata)
end
