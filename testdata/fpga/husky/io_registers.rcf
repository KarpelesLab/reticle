# NewAE ChipWhisperer-Husky (XC7A35T-FTG256): the pins of `io_registers.v`.
#
# PROVENANCE: transcribed from NewAE's `fpga/vivado/cwhusky.xdc` at
# chipwhisperer-husky-fpga 2dfe1bc. ADC_DP0/ADC_DN0 are its ADC_DP[0] and
# ADC_DN[0]; LED_ADC keeps its `DRIVE 8`, and LED_GLITCH stands in for one
# of the glitch outputs, whose own balls are on the target connector.
set_io -io_standard LVDS_25 PLLFPGAP D13
set_io -io_standard LVDS_25 PLLFPGAN C13
set_io -io_standard LVDS_25 ADC_DP0 B12
set_io -io_standard LVDS_25 ADC_DN0 A12
set_io -io_standard LVDS_25 ADC_CLKP J15
set_io -io_standard LVDS_25 ADC_CLKN J16
set_io -io_standard LVCMOS33 -drive 8 LED_ADC C7
set_io -io_standard LVCMOS33 -drive 8 LED_GLITCH C6
