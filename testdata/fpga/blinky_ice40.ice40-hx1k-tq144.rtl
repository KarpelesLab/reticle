top blinky

module blinky
  net %clk u1 wire
  net %rst u1 wire
  net %led u1 wire
  net %count u8 wire
  net %next u8 wire
  net %inc$c0 u1 wire
  net %inc$c1 u1 wire
  net %inc$c2 u1 wire
  net %inc$c3 u1 wire
  net %inc$c4 u1 wire
  net %inc$c5 u1 wire
  net %inc$c6 u1 wire
  net %clk$pad u1 wire
  net %clk$in0 u1 wire
  net %rst$pad u1 wire
  net %rst$in0 u1 wire
  net %led$pad u1 wire
  net %led$pin0 u1 wire
  net %clk$gb u1 wire
  net %$lut0 u1 wire
  net %$lut1 u1 wire
  net %$lut2 u1 wire
  net %$lut3 u1 wire
  net %$lut4 u1 wire
  net %$lut5 u1 wire
  net %$lut6 u1 wire
  net %$lut7 u1 wire
  net %counter$q0 u1 wire
  net %counter$q1 u1 wire
  net %counter$q2 u1 wire
  net %counter$q3 u1 wire
  net %counter$q4 u1 wire
  net %counter$q5 u1 wire
  net %counter$q6 u1 wire
  net %counter$q7 u1 wire
  port clk in %clk$pad
  port rst in %rst$pad
  port led out %led$pad
  assign %clk = %clk$in0
  assign %rst = %rst$in0
  assign %led = %count[7:7]
  assign %next = {%$lut0, %$lut1, %$lut2, %$lut3, %$lut4, %$lut5, %$lut6, %$lut7}
  assign %led$pad = %led$pin0
  assign %count = {%counter$q7, %counter$q6, %counter$q5, %counter$q4, %counter$q3, %counter$q2, %counter$q1, %counter$q0}
  cell inc$carry0 blackbox SB_CARRY (CI=1'd0, I0=%count[0:0], I1=8'd1[0:0]) -> (CO=%inc$c0)
  cell inc$carry1 blackbox SB_CARRY (CI=%inc$c0, I0=%count[1:1], I1=8'd1[1:1]) -> (CO=%inc$c1)
  cell inc$carry2 blackbox SB_CARRY (CI=%inc$c1, I0=%count[2:2], I1=8'd1[2:2]) -> (CO=%inc$c2)
  cell inc$carry3 blackbox SB_CARRY (CI=%inc$c2, I0=%count[3:3], I1=8'd1[3:3]) -> (CO=%inc$c3)
  cell inc$carry4 blackbox SB_CARRY (CI=%inc$c3, I0=%count[4:4], I1=8'd1[4:4]) -> (CO=%inc$c4)
  cell inc$carry5 blackbox SB_CARRY (CI=%inc$c4, I0=%count[5:5], I1=8'd1[5:5]) -> (CO=%inc$c5)
  cell inc$carry6 blackbox SB_CARRY (CI=%inc$c5, I0=%count[6:6], I1=8'd1[6:6]) -> (CO=%inc$c6)
  attr port = "clk"
  attr pin = "21"
  attr io_standard = "LVCMOS33"
  cell clk$io0 blackbox SB_IO #(PIN_TYPE=6'd1) (PACKAGE_PIN=%clk$pad) -> (D_IN_0=%clk$in0)
  attr port = "rst"
  attr pin = "8"
  attr io_standard = "LVCMOS33"
  cell rst$io0 blackbox SB_IO #(PIN_TYPE=6'd1) (PACKAGE_PIN=%rst$pad) -> (D_IN_0=%rst$in0)
  attr port = "led"
  attr pin = "99"
  attr io_standard = "LVCMOS33"
  attr pullup = 0
  cell led$io0 blackbox SB_IO #(PIN_TYPE=6'd25) (D_OUT_0=%led) -> (PACKAGE_PIN=%led$pin0)
  cell clk$gbuf blackbox SB_GB (USER_SIGNAL_TO_GLOBAL_BUFFER=%clk) -> (GLOBAL_BUFFER_OUTPUT=%clk$gb)
  cell $lut8 blackbox SB_LUT4 #(LUT_INIT=16'd26214) (I0={%inc$c6, %count[7:7]}[0:0], I1={%inc$c6, %count[7:7]}[1:1], I2=1'd0, I3=1'd0) -> (O=%$lut0)
  cell $lut9 blackbox SB_LUT4 #(LUT_INIT=16'd26214) (I0={%inc$c5, %count[6:6]}[0:0], I1={%inc$c5, %count[6:6]}[1:1], I2=1'd0, I3=1'd0) -> (O=%$lut1)
  cell $lut10 blackbox SB_LUT4 #(LUT_INIT=16'd26214) (I0={%inc$c4, %count[5:5]}[0:0], I1={%inc$c4, %count[5:5]}[1:1], I2=1'd0, I3=1'd0) -> (O=%$lut2)
  cell $lut11 blackbox SB_LUT4 #(LUT_INIT=16'd26214) (I0={%inc$c3, %count[4:4]}[0:0], I1={%inc$c3, %count[4:4]}[1:1], I2=1'd0, I3=1'd0) -> (O=%$lut3)
  cell $lut12 blackbox SB_LUT4 #(LUT_INIT=16'd26214) (I0={%inc$c2, %count[3:3]}[0:0], I1={%inc$c2, %count[3:3]}[1:1], I2=1'd0, I3=1'd0) -> (O=%$lut4)
  cell $lut13 blackbox SB_LUT4 #(LUT_INIT=16'd26214) (I0={%inc$c1, %count[2:2]}[0:0], I1={%inc$c1, %count[2:2]}[1:1], I2=1'd0, I3=1'd0) -> (O=%$lut5)
  cell $lut14 blackbox SB_LUT4 #(LUT_INIT=16'd26214) (I0={%inc$c0, %count[1:1]}[0:0], I1={%inc$c0, %count[1:1]}[1:1], I2=1'd0, I3=1'd0) -> (O=%$lut6)
  cell $lut15 blackbox SB_LUT4 #(LUT_INIT=16'd21845) (I0=%count[0:0], I1=1'd0, I2=1'd0, I3=1'd0) -> (O=%$lut7)
  cell counter$ff0 blackbox SB_DFFSR (C=%clk$gb, D=%next[0:0], R=%rst) -> (Q=%counter$q0)
  cell counter$ff1 blackbox SB_DFFSR (C=%clk$gb, D=%next[1:1], R=%rst) -> (Q=%counter$q1)
  cell counter$ff2 blackbox SB_DFFSR (C=%clk$gb, D=%next[2:2], R=%rst) -> (Q=%counter$q2)
  cell counter$ff3 blackbox SB_DFFSR (C=%clk$gb, D=%next[3:3], R=%rst) -> (Q=%counter$q3)
  cell counter$ff4 blackbox SB_DFFSR (C=%clk$gb, D=%next[4:4], R=%rst) -> (Q=%counter$q4)
  cell counter$ff5 blackbox SB_DFFSR (C=%clk$gb, D=%next[5:5], R=%rst) -> (Q=%counter$q5)
  cell counter$ff6 blackbox SB_DFFSR (C=%clk$gb, D=%next[6:6], R=%rst) -> (Q=%counter$q6)
  cell counter$ff7 blackbox SB_DFFSR (C=%clk$gb, D=%next[7:7], R=%rst) -> (Q=%counter$q7)
end
