# ULX3S-style pins: the 25 MHz oscillator and two LEDs. See
# src/fpga/devices/ecp5.dev for where these pin names come from.
set_io -io_standard LVCMOS33 -drive 8 -slew fast clk G2
set_io -io_standard LVCMOS33 rst B2
set_io -io_standard LVCMOS33 -pullup yes led C1
create_clock -name sys -period 40.0 clk
clock_domain sys clk
