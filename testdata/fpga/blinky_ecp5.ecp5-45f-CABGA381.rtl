top blinky

module blinky
  net %clk u1 wire
  net %rst u1 wire
  net %led u1 wire
  net %count u8 wire
  net %next u8 wire
  net %inc$s0_1 u1 wire
  net %inc$co0 u1 wire
  net %inc$s1_0 u1 wire
  net %inc$s1_1 u1 wire
  net %inc$co1 u1 wire
  net %inc$s2_0 u1 wire
  net %inc$s2_1 u1 wire
  net %inc$co2 u1 wire
  net %inc$s3_0 u1 wire
  net %inc$s3_1 u1 wire
  net %inc$co3 u1 wire
  net %inc$s4_0 u1 wire
  net %inc$co4 u1 wire
  net %clk$pad u1 wire
  net %clk$in0 u1 wire
  net %rst$pad u1 wire
  net %rst$in0 u1 wire
  net %led$pad u1 wire
  net %led$pin0 u1 wire
  net %clk$gb u1 wire
  net %counter$q0 u1 wire
  net %counter$q1 u1 wire
  net %counter$q2 u1 wire
  net %counter$q3 u1 wire
  net %counter$q4 u1 wire
  net %counter$q5 u1 wire
  net %counter$q6 u1 wire
  net %counter$q7 u1 wire
  port clk in %clk$pad
  port rst in %rst$pad
  port led out %led$pad
  assign %clk = %clk$in0
  assign %rst = %rst$in0
  assign %led = %count[7:7]
  assign %next = {%inc$s4_0, %inc$s3_1, %inc$s3_0, %inc$s2_1, %inc$s2_0, %inc$s1_1, %inc$s1_0, %inc$s0_1}
  assign %led$pad = %led$pin0
  assign %count = {%counter$q7, %counter$q6, %counter$q5, %counter$q4, %counter$q3, %counter$q2, %counter$q1, %counter$q0}
  cell inc$carry0 blackbox CCU2C #(INIT0=16'd0, INIT1=16'd26218, INJECT1_0="NO", INJECT1_1="NO") (A1=%count[0:0], B1=8'd1[0:0]) -> (S1=%inc$s0_1, COUT=%inc$co0)
  cell inc$carry1 blackbox CCU2C #(INIT0=16'd26218, INIT1=16'd26218, INJECT1_0="NO", INJECT1_1="NO") (A0=%count[1:1], B0=8'd1[1:1], A1=%count[2:2], B1=8'd1[2:2], CIN=%inc$co0) -> (S0=%inc$s1_0, S1=%inc$s1_1, COUT=%inc$co1)
  cell inc$carry2 blackbox CCU2C #(INIT0=16'd26218, INIT1=16'd26218, INJECT1_0="NO", INJECT1_1="NO") (A0=%count[3:3], B0=8'd1[3:3], A1=%count[4:4], B1=8'd1[4:4], CIN=%inc$co1) -> (S0=%inc$s2_0, S1=%inc$s2_1, COUT=%inc$co2)
  cell inc$carry3 blackbox CCU2C #(INIT0=16'd26218, INIT1=16'd26218, INJECT1_0="NO", INJECT1_1="NO") (A0=%count[5:5], B0=8'd1[5:5], A1=%count[6:6], B1=8'd1[6:6], CIN=%inc$co2) -> (S0=%inc$s3_0, S1=%inc$s3_1, COUT=%inc$co3)
  cell inc$carry4 blackbox CCU2C #(INIT0=16'd26218, INIT1=16'd0, INJECT1_0="NO", INJECT1_1="NO") (A0=%count[7:7], B0=8'd1[7:7], CIN=%inc$co3) -> (S0=%inc$s4_0, COUT=%inc$co4)
  attr port = "clk"
  attr pin = "G2"
  attr io_standard = "LVCMOS33"
  attr drive = 8
  attr slew = "fast"
  cell clk$io0 blackbox TRELLIS_IO #(DIR="INPUT") (B=%clk$pad) -> (O=%clk$in0)
  attr port = "rst"
  attr pin = "B2"
  attr io_standard = "LVCMOS33"
  cell rst$io0 blackbox TRELLIS_IO #(DIR="INPUT") (B=%rst$pad) -> (O=%rst$in0)
  attr port = "led"
  attr pin = "C1"
  attr io_standard = "LVCMOS33"
  attr pullup = 1
  cell led$io0 blackbox TRELLIS_IO #(DIR="OUTPUT", PULLMODE="UP") (I=%led) -> (B=%led$pin0)
  cell clk$gbuf blackbox DCCA (CLKI=%clk, CE=1'd1) -> (CLKO=%clk$gb)
  cell counter$ff0 blackbox TRELLIS_FF #(GSR="DISABLED", REGMODE="FF", CEMUX=1, CLKMUX="CLK", LSRMUX="LSR", SRMODE="LSR_OVER_CE", REGSET="RESET") (CLK=%clk$gb, DI=%next[0:0], CE=1'd1, LSR=%rst) -> (Q=%counter$q0)
  cell counter$ff1 blackbox TRELLIS_FF #(GSR="DISABLED", REGMODE="FF", CEMUX=1, CLKMUX="CLK", LSRMUX="LSR", SRMODE="LSR_OVER_CE", REGSET="RESET") (CLK=%clk$gb, DI=%next[1:1], CE=1'd1, LSR=%rst) -> (Q=%counter$q1)
  cell counter$ff2 blackbox TRELLIS_FF #(GSR="DISABLED", REGMODE="FF", CEMUX=1, CLKMUX="CLK", LSRMUX="LSR", SRMODE="LSR_OVER_CE", REGSET="RESET") (CLK=%clk$gb, DI=%next[2:2], CE=1'd1, LSR=%rst) -> (Q=%counter$q2)
  cell counter$ff3 blackbox TRELLIS_FF #(GSR="DISABLED", REGMODE="FF", CEMUX=1, CLKMUX="CLK", LSRMUX="LSR", SRMODE="LSR_OVER_CE", REGSET="RESET") (CLK=%clk$gb, DI=%next[3:3], CE=1'd1, LSR=%rst) -> (Q=%counter$q3)
  cell counter$ff4 blackbox TRELLIS_FF #(GSR="DISABLED", REGMODE="FF", CEMUX=1, CLKMUX="CLK", LSRMUX="LSR", SRMODE="LSR_OVER_CE", REGSET="RESET") (CLK=%clk$gb, DI=%next[4:4], CE=1'd1, LSR=%rst) -> (Q=%counter$q4)
  cell counter$ff5 blackbox TRELLIS_FF #(GSR="DISABLED", REGMODE="FF", CEMUX=1, CLKMUX="CLK", LSRMUX="LSR", SRMODE="LSR_OVER_CE", REGSET="RESET") (CLK=%clk$gb, DI=%next[5:5], CE=1'd1, LSR=%rst) -> (Q=%counter$q5)
  cell counter$ff6 blackbox TRELLIS_FF #(GSR="DISABLED", REGMODE="FF", CEMUX=1, CLKMUX="CLK", LSRMUX="LSR", SRMODE="LSR_OVER_CE", REGSET="RESET") (CLK=%clk$gb, DI=%next[6:6], CE=1'd1, LSR=%rst) -> (Q=%counter$q6)
  cell counter$ff7 blackbox TRELLIS_FF #(GSR="DISABLED", REGMODE="FF", CEMUX=1, CLKMUX="CLK", LSRMUX="LSR", SRMODE="LSR_OVER_CE", REGSET="RESET") (CLK=%clk$gb, DI=%next[7:7], CE=1'd1, LSR=%rst) -> (Q=%counter$q7)
end
