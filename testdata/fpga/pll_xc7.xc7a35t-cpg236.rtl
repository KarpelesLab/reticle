top pllshift

module pllshift
  net %clk u1 wire
  attr clock_mhz = 50
  net %sys u1 wire
  net %q u1 wire
  net %sr u8 wire
  net %next u8 wire
  net %clk$pad u1 wire
  net %clk$in0 u1 wire
  net %d$pad u1 wire
  net %d$in0 u1 wire
  net %q$pad u1 wire
  net %q$pin0 u1 wire
  net %sys$fb u1 wire
  net %sys$gb u1 wire
  net %sr$q0 u1 wire
  net %sr$q1 u1 wire
  net %sr$q2 u1 wire
  net %sr$q3 u1 wire
  net %sr$q4 u1 wire
  net %sr$q5 u1 wire
  net %sr$q6 u1 wire
  net %sr$q7 u1 wire
  port clk in %clk$pad
  port d in %d$pad
  port q out %q$pad
  assign %clk = %clk$in0
  assign %q = %sr[7:7]
  assign %next = {%sr[6:6], %sr[5:5], %sr[4:4], %sr[3:3], %sr[2:2], %sr[1:1], %sr[0:0], %d$in0}
  assign %q$pad = %q$pin0
  assign %sr = {%sr$q7, %sr$q6, %sr$q5, %sr$q4, %sr$q3, %sr$q2, %sr$q1, %sr$q0}
  attr port = "clk"
  attr pin = "W5"
  attr io_standard = "LVCMOS33"
  cell clk$io0 blackbox IBUF (I=%clk$pad) -> (O=%clk$in0)
  attr port = "d"
  attr pin = "V17"
  attr io_standard = "LVCMOS33"
  cell d$io0 blackbox IBUF (I=%d$pad) -> (O=%d$in0)
  attr port = "q"
  attr pin = "U16"
  attr io_standard = "LVCMOS33"
  cell q$io0 blackbox OBUF (I=%q) -> (O=%q$pin0)
  attr frequency_mhz = "50.000000"
  cell sys$pll blackbox PLLE2_BASE #(STARTUP_WAIT="FALSE", BANDWIDTH="OPTIMIZED", DIVCLK_DIVIDE=1, CLKFBOUT_MULT=8, CLKOUT0_DIVIDE=16) (CLKIN1=%clk, CLKFBIN=%sys$fb, RST=1'd0, PWRDWN=1'd0) -> (CLKOUT0=%sys, CLKFBOUT=%sys$fb)
  cell sys$gbuf blackbox BUFG (I=%sys) -> (O=%sys$gb)
  cell sr$ff0 blackbox FDRE #(INIT=1'd0) (C=%sys$gb, D=%next[0:0], CE=1'd1, R=1'd0) -> (Q=%sr$q0)
  cell sr$ff1 blackbox FDRE #(INIT=1'd0) (C=%sys$gb, D=%next[1:1], CE=1'd1, R=1'd0) -> (Q=%sr$q1)
  cell sr$ff2 blackbox FDRE #(INIT=1'd0) (C=%sys$gb, D=%next[2:2], CE=1'd1, R=1'd0) -> (Q=%sr$q2)
  cell sr$ff3 blackbox FDRE #(INIT=1'd0) (C=%sys$gb, D=%next[3:3], CE=1'd1, R=1'd0) -> (Q=%sr$q3)
  cell sr$ff4 blackbox FDRE #(INIT=1'd0) (C=%sys$gb, D=%next[4:4], CE=1'd1, R=1'd0) -> (Q=%sr$q4)
  cell sr$ff5 blackbox FDRE #(INIT=1'd0) (C=%sys$gb, D=%next[5:5], CE=1'd1, R=1'd0) -> (Q=%sr$q5)
  cell sr$ff6 blackbox FDRE #(INIT=1'd0) (C=%sys$gb, D=%next[6:6], CE=1'd1, R=1'd0) -> (Q=%sr$q6)
  cell sr$ff7 blackbox FDRE #(INIT=1'd0) (C=%sys$gb, D=%next[7:7], CE=1'd1, R=1'd0) -> (Q=%sr$q7)
end
