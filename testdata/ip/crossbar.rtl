  assign %sub_wready = mux(eq(%sel, 2'd0), %m0_wready, mux(eq(%sel, 2'd1), %m1_wready, %no_data_yet))
  assign %sub_bvalid = mux(eq(%sel, 2'd0), %m0_bvalid, mux(eq(%sel, 2'd1), %m1_bvalid, %write_complete))
  assign %sub_bresp = mux(eq(%sel, 2'd0), %m0_bresp, mux(eq(%sel, 2'd1), %m1_bresp, 2'd3))
  assign %sub_arready = mux(eq(%sel, 2'd0), %m0_arready, mux(eq(%sel, 2'd1), %m1_arready, %no_addr_yet))
  assign %sub_rvalid = mux(eq(%sel, 2'd0), %m0_rvalid, mux(eq(%sel, 2'd1), %m1_rvalid, %addr_done))
  assign %sub_rdata = mux(eq(%sel, 2'd0), %m0_rdata, mux(eq(%sel, 2'd1), %m1_rdata, 32'd0))
  assign %sub_rresp = mux(eq(%sel, 2'd0), %m0_rresp, mux(eq(%sel, 2'd1), %m1_rresp, 2'd3))
  assign %m0_awvalid = and(and(%in_write, %sel_is0), %mgr_awvalid)
  assign %m0_wvalid = and(and(%in_write, %sel_is0), %mgr_wvalid)
  assign %m0_bready = and(and(%in_write, %sel_is0), %mgr_bready)
  assign %m0_arvalid = and(and(%in_read, %sel_is0), %mgr_arvalid)
  assign %m0_rready = and(and(%in_read, %sel_is0), %mgr_rready)
  assign %m0_awaddr = %mgr_awaddr
  assign %m0_awprot = %mgr_awprot
  assign %m0_wdata = %mgr_wdata
  assign %m0_wstrb = %mgr_wstrb
  assign %m0_araddr = %mgr_araddr
  assign %m0_arprot = %mgr_arprot
  assign %m1_awvalid = and(and(%in_write, %sel_is1), %mgr_awvalid)
  assign %m1_wvalid = and(and(%in_write, %sel_is1), %mgr_wvalid)
  assign %m1_bready = and(and(%in_write, %sel_is1), %mgr_bready)
  assign %m1_arvalid = and(and(%in_read, %sel_is1), %mgr_arvalid)
  assign %m1_rready = and(and(%in_read, %sel_is1), %mgr_rready)
  assign %m1_awaddr = %mgr_awaddr
  assign %m1_awprot = %mgr_awprot
  assign %m1_wdata = %mgr_wdata
  assign %m1_wstrb = %mgr_wstrb
  assign %m1_araddr = %mgr_araddr
  assign %m1_arprot = %mgr_arprot
  assign %s0_awready = and(and(%in_write, %grant_is0), %sub_awready)
  assign %s0_wready = and(and(%in_write, %grant_is0), %sub_wready)
  assign %s0_bvalid = and(and(%in_write, %grant_is0), %sub_bvalid)
  assign %s0_arready = and(and(%in_read, %grant_is0), %sub_arready)
  assign %s0_rvalid = and(and(%in_read, %grant_is0), %sub_rvalid)
  assign %s0_bresp = %sub_bresp
  assign %s0_rdata = %sub_rdata
  assign %s0_rresp = %sub_rresp
  assign %s1_awready = and(and(%in_write, %grant_is1), %sub_awready)
  assign %s1_wready = and(and(%in_write, %grant_is1), %sub_wready)
  assign %s1_bvalid = and(and(%in_write, %grant_is1), %sub_bvalid)
  assign %s1_arready = and(and(%in_read, %grant_is1), %sub_arready)
  assign %s1_rvalid = and(and(%in_read, %grant_is1), %sub_rvalid)
  assign %s1_bresp = %sub_bresp
  assign %s1_rdata = %sub_rdata
  assign %s1_rresp = %sub_rresp
  process arbiter seq posedge %clk async negedge %rst_n
    if lnot(%rst_n)
      %state <= 2'd0
      %grant <= 1'd0
      %sel <= 2'd0
      %rr <= 1'd0
      %addr_done <= 1'd0
      %w_done <= 1'd0
    else
      if eq(%state, 2'd0)
        if %any_req
          %grant <= %nxt_grant
          %rr <= %nxt_grant
          %sel <= %nxt_sel
          %state <= mux(%nxt_is_write, 2'd1, 2'd2)
          %addr_done <= 1'd0
          %w_done <= 1'd0
        end
      else
        if %in_write
          if and(%sub_awready, %mgr_awvalid)
            %addr_done <= 1'd1
          end
          if and(%sub_wready, %mgr_wvalid)
            %w_done <= 1'd1
          end
          if and(%sub_bvalid, %mgr_bready)
            %state <= 2'd0
          end
        else
          if and(%sub_arready, %mgr_arvalid)
            %addr_done <= 1'd1
          end
          if and(%sub_rvalid, %mgr_rready)
            %state <= 2'd0
          end
        end
      end
    end
  end
end

