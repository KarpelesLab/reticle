  assign %mgr_awvalid = mux(eq(%grant, 1'd0), %s0_awvalid, mux(eq(%grant, 1'd1), %s1_awvalid, 1'd0))
  assign %mgr_wdata = mux(eq(%grant, 1'd0), %s0_wdata, mux(eq(%grant, 1'd1), %s1_wdata, 32'd0))
  assign %mgr_wstrb = mux(eq(%grant, 1'd0), %s0_wstrb, mux(eq(%grant, 1'd1), %s1_wstrb, 4'd0))
  assign %mgr_wvalid = mux(eq(%grant, 1'd0), %s0_wvalid, mux(eq(%grant, 1'd1), %s1_wvalid, 1'd0))
  assign %mgr_bready = mux(eq(%grant, 1'd0), %s0_bready, mux(eq(%grant, 1'd1), %s1_bready, 1'd0))
