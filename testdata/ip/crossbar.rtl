module axil_regs
  net %clk u1 wire
  net %rst_n u1 wire
  net %s_awaddr u32 wire
  net %s_awprot u3 wire
  net %s_awvalid u1 wire
  net %s_awready u1 wire
  net %s_wdata u32 wire
  net %s_wstrb u4 wire
  net %s_wvalid u1 wire
  net %s_wready u1 wire
  net %s_bresp u2 wire
  net %s_bvalid u1 wire
  net %s_bready u1 wire
  net %s_araddr u32 wire
  net %s_arprot u3 wire
  net %s_arvalid u1 wire
  net %s_arready u1 wire
  net %s_rdata u32 wire
  net %s_rresp u2 wire
  net %s_rvalid u1 wire
  net %s_rready u1 wire
  net %r0 u32 reg
  net %r1 u32 reg
  net %r2 u32 reg
  net %r3 u32 reg
  net %awaddr_q u32 reg
  net %wdata_q u32 reg
  net %rdata_q u32 reg
  net %aw_seen u1 reg
  net %w_seen u1 reg
  net %bvalid_q u1 reg
  net %rvalid_q u1 reg
  port clk in %clk
  port rst_n in %rst_n
  port s_awaddr in %s_awaddr
  port s_awprot in %s_awprot
  port s_awvalid in %s_awvalid
  port s_awready out %s_awready
  port s_wdata in %s_wdata
  port s_wstrb in %s_wstrb
  port s_wvalid in %s_wvalid
  port s_wready out %s_wready
  port s_bresp out %s_bresp
  port s_bvalid out %s_bvalid
  port s_bready in %s_bready
  port s_araddr in %s_araddr
  port s_arprot in %s_arprot
  port s_arvalid in %s_arvalid
  port s_arready out %s_arready
  port s_rdata out %s_rdata
  port s_rresp out %s_rresp
  port s_rvalid out %s_rvalid
  port s_rready in %s_rready
  assign %s_awready = land(lnot(%aw_seen), lnot(%bvalid_q))
  assign %s_wready = land(lnot(%w_seen), lnot(%bvalid_q))
  assign %s_bvalid = %bvalid_q
  assign %s_bresp = 2'd0
  assign %s_arready = lnot(%rvalid_q)
  assign %s_rvalid = %rvalid_q
  assign %s_rdata = %rdata_q
  assign %s_rresp = 2'd0
  process seq posedge %clk async negedge %rst_n
    if lnot(%rst_n)
      %r0 <= 32'd0
      %r1 <= 32'd0
      %r2 <= 32'd0
      %r3 <= 32'd0
      %awaddr_q <= 32'd0
      %wdata_q <= 32'd0
      %rdata_q <= 32'd0
      %aw_seen <= 1'd0
      %w_seen <= 1'd0
      %bvalid_q <= 1'd0
      %rvalid_q <= 1'd0
    else
      if land(%s_awvalid, %s_awready)
        %aw_seen <= 1'd1
        %awaddr_q <= %s_awaddr
      end
      if land(%s_wvalid, %s_wready)
        %w_seen <= 1'd1
        %wdata_q <= %s_wdata
      end
      if land(land(%aw_seen, %w_seen), lnot(%bvalid_q))
        case %awaddr_q[3:2]
          when 2'd0
            %r0 <= %wdata_q
          end
          when 2'd1
            %r1 <= %wdata_q
          end
          when 2'd2
            %r2 <= %wdata_q
          end
          default
            %r3 <= %wdata_q
          end
        end
        %aw_seen <= 1'd0
        %w_seen <= 1'd0
        %bvalid_q <= 1'd1
      end
      if land(%bvalid_q, %s_bready)
        %bvalid_q <= 1'd0
      end
      if land(%s_arvalid, %s_arready)
        case %s_araddr[3:2]
          when 2'd0
            %rdata_q <= %r0
          end
          when 2'd1
            %rdata_q <= %r1
          end
          when 2'd2
            %rdata_q <= %r2
          end
          default
            %rdata_q <= %r3
          end
        end
        %rvalid_q <= 1'd1
      else
        if land(%rvalid_q, %s_rready)
          %rvalid_q <= 1'd0
        end
      end
    end
  end
end

