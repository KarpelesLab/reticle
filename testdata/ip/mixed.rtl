top top

module top
  timescale 1 ns / 1 ps
  net %clk u1 wire
  net %rst u1 wire
  net %gray u4 wire
  port clk in %clk
  port rst in %rst
  port gray out %gray
  instance u_gray of gray_counter (clk=%clk, rst=%rst, gray=%gray)
end

module gray_counter
  timescale 1 fs / 1 fs
  net %clk u1 wire
  net %rst u1 wire
  net %gray u4 wire
  net %count u4 reg
  port clk in %clk
  port rst in %rst
  port gray out %gray
  assign %gray[3:3] = %count[3:3]
  assign %gray[2:2] = xor(%count[3:3], %count[2:2])
  assign %gray[1:1] = xor(%count[2:2], %count[1:1])
  assign %gray[0:0] = xor(%count[1:1], %count[0:0])
  process seq posedge %clk async posedge %rst
    if eq(%rst, 1'd1)
      %count <= 4'd0
    else
      %count[0:0] <= not(%count[0:0])
      %count[1:1] <= xor(%count[1:1], %count[0:0])
      %count[2:2] <= xor(%count[2:2], and(%count[1:1], %count[0:0]))
      %count[3:3] <= xor(%count[3:3], and(and(%count[2:2], %count[1:1]), %count[0:0]))
    end
  end
end
