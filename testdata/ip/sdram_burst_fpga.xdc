# The pins of testdata/ip/sdram_burst_fpga.v on the XC7A100T-FGG484.
# PLACEHOLDERS: the board's pinout is not known yet. Every SDRAM pin is in
# HR bank 35, so one IDELAYCTRL serves every delay; the 50 MHz clock on the
# bank's MRCC pin H4; reset and the status lights in bank 34. The bank's two
# single-pad balls (F4, IO_0; L6, IO_25) are left out: this flow cannot
# route an ODDR to such a pad (ip/memory/sdram_burst/README.md, "The flow").
set_property -dict {PACKAGE_PIN H4 IOSTANDARD LVCMOS33} [get_ports clk_in]
set_property -dict {PACKAGE_PIN A1 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_clk}]
set_property -dict {PACKAGE_PIN B1 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_cke}]
set_property -dict {PACKAGE_PIN B2 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_cs_n}]
set_property -dict {PACKAGE_PIN C2 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_ras_n}]
set_property -dict {PACKAGE_PIN D1 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_cas_n}]
set_property -dict {PACKAGE_PIN D2 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_we_n}]
set_property -dict {PACKAGE_PIN E1 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_ba[0]}]
set_property -dict {PACKAGE_PIN E2 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_ba[1]}]
set_property -dict {PACKAGE_PIN E3 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_a[0]}]
set_property -dict {PACKAGE_PIN F1 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_a[1]}]
set_property -dict {PACKAGE_PIN F3 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_a[2]}]
set_property -dict {PACKAGE_PIN G1 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_a[3]}]
set_property -dict {PACKAGE_PIN G2 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_a[4]}]
set_property -dict {PACKAGE_PIN G3 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_a[5]}]
set_property -dict {PACKAGE_PIN G4 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_a[6]}]
set_property -dict {PACKAGE_PIN H2 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_a[7]}]
set_property -dict {PACKAGE_PIN H3 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_a[8]}]
set_property -dict {PACKAGE_PIN H5 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_a[9]}]
set_property -dict {PACKAGE_PIN J1 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_a[10]}]
set_property -dict {PACKAGE_PIN J2 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_a[11]}]
set_property -dict {PACKAGE_PIN J4 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_a[12]}]
set_property -dict {PACKAGE_PIN J5 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_dqm[0]}]
set_property -dict {PACKAGE_PIN J6 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_dqm[1]}]
set_property -dict {PACKAGE_PIN K1 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_dq[0]}]
set_property -dict {PACKAGE_PIN K2 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_dq[1]}]
set_property -dict {PACKAGE_PIN K3 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_dq[2]}]
set_property -dict {PACKAGE_PIN K4 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_dq[3]}]
set_property -dict {PACKAGE_PIN K6 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_dq[4]}]
set_property -dict {PACKAGE_PIN L1 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_dq[5]}]
set_property -dict {PACKAGE_PIN L3 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_dq[6]}]
set_property -dict {PACKAGE_PIN L4 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_dq[7]}]
set_property -dict {PACKAGE_PIN L5 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_dq[8]}]
set_property -dict {PACKAGE_PIN M1 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_dq[9]}]
set_property -dict {PACKAGE_PIN M2 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_dq[10]}]
set_property -dict {PACKAGE_PIN M3 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_dq[11]}]
set_property -dict {PACKAGE_PIN M5 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_dq[12]}]
set_property -dict {PACKAGE_PIN M6 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_dq[13]}]
set_property -dict {PACKAGE_PIN N2 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_dq[14]}]
set_property -dict {PACKAGE_PIN N3 IOSTANDARD LVCMOS33 DRIVE 12 SLEW FAST} [get_ports {sdram_dq[15]}]
set_property -dict {PACKAGE_PIN AA1 IOSTANDARD LVCMOS33} [get_ports {rst_n}]
set_property -dict {PACKAGE_PIN AB1 IOSTANDARD LVCMOS33} [get_ports {led[0]}]
set_property -dict {PACKAGE_PIN AB2 IOSTANDARD LVCMOS33} [get_ports {led[1]}]
set_property -dict {PACKAGE_PIN AB3 IOSTANDARD LVCMOS33} [get_ports {led[2]}]
set_property -dict {PACKAGE_PIN AA3 IOSTANDARD LVCMOS33} [get_ports {led[3]}]
create_clock -period 20 [get_ports clk_in]
