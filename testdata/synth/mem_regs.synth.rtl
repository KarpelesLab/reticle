top mem_regs

module mem_regs
  net %clk u1 wire
  net %a u8 wire
  net %b u8 wire
  net %sel u1 wire
  net %en u1 wire
  net %ce u1 wire
  net %d u1 wire
  net %w u8 wire
  net %y u8 wire
  net %z u8 wire
  net %r u8 wire
  attr init = 8'd1
  net %c$0 u8 wire
  attr init = 8'd2
  net %c$1 u8 wire
  attr init = 8'd3
  net %c$2 u8 wire
  attr init = 8'd4
  net %c$3 u8 wire
  attr init = 8'd5
  net %c$4 u8 wire
  port clk in %clk
  port a in %a
  port b in %b
  port sel in %sel
  port en in %en
  port ce in %ce
  port d in %d
  port w out %w
  port y out %y
  port z out %z
  port r out %r
  assign %w = %c$4
  assign %y = %c$3
  assign %z = 8'd6
  cell c$0$ff dff pos (clk=%clk, d=%a) -> (q=%c$0)
  cell c$1$ff dff pos (clk=%clk, d=%c$0) -> (q=%c$1)
  cell c$2$ff dff pos (clk=%clk, d=add(%c$1, 8'd1)) -> (q=%c$2)
  cell c$3$ff dff pos (clk=%clk, d=mux(%sel, %b, %c$2)) -> (q=%c$3)
  cell c$4$ff dff pos srst neg 8'd0 (clk=%clk, d=mux(%d, %a, %b), rst=%ce) -> (q=%c$4)
  cell c$rd$ff dff pos en (clk=%clk, d=%c$3, en=%en) -> (q=%r)
end
