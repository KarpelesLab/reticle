top priority8

module priority8
  net %d u8 wire
  net %idx u3 wire
  net %valid u1 wire
  port d in %d
  port idx out %idx
  port valid out %valid
  assign %idx = mux(%d[7:7], 3'd7, mux(%d[6:6], 3'd6, mux(%d[5:5], 3'd5, mux(%d[4:4], 3'd4, mux(%d[3:3], 3'd3, mux(%d[2:2], 3'd2, mux(%d[1:1], 3'd1, mux(%d[0:0], 3'd0, 3'd0))))))))
  assign %valid = ror(%d)
end
