top decoder4to16

module decoder4to16
  net %sel u4 wire
  net %en u1 wire
  net %y u16 wire
  port sel in %sel
  port en in %en
  port y out %y
  assign %y = {land(eq(%sel, 4'd15), %en), land(eq(%sel, 4'd14), %en), land(eq(%sel, 4'd13), %en), land(eq(%sel, 4'd12), %en), land(eq(%sel, 4'd11), %en), land(eq(%sel, 4'd10), %en), land(eq(%sel, 4'd9), %en), land(eq(%sel, 4'd8), %en), land(eq(%sel, 4'd7), %en), land(eq(%sel, 4'd6), %en), land(eq(%sel, 4'd5), %en), land(eq(%sel, 4'd4), %en), land(eq(%sel, 4'd3), %en), land(eq(%sel, 4'd2), %en), land(eq(%sel, 4'd1), %en), land(eq(%sel, 4'd0), %en)}
end
