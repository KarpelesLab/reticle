top dead_logic

module dead_logic
  net %clk u1 wire
  net %a u4 wire
  net %b u4 wire
  net %y u4 wire
  net %unused u4 wire
  net %stale u4 reg
  net %tmp u4 wire
  port clk in %clk
  port a in %a
  port b in %b
  port y out %y
  assign %tmp = and(%a, %b)
  assign %unused = mul(%tmp, %b)
  assign %y = or(%tmp, %b)
  process seq posedge %clk
    %stale <= add(%stale, %unused)
  end
end
