top mux_tree

module mux_tree
  net %a u1 wire
  net %b u1 wire
  net %c u1 wire
  net %x u8 wire
  net %y u8 wire
  net %out u8 wire
  net %flag u1 wire
  port a in %a
  port b in %b
  port c in %c
  port x in %x
  port y in %y
  port out out %out
  port flag out %flag
  assign %out = mux(%a, mux(%b, %x, %y), mux(%c, add(%x, %y), 8'd0))
  assign %flag = and(%a, not(%b))
end
