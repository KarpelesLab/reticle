top ram_regread

module ram_regread
  net %clk u1 wire
  net %we u1 wire
  net %waddr u4 wire
  net %raddr u4 wire
  net %wdata u8 wire
  net %rdata u8 wire
  net %rom_out u8 wire
  port clk in %clk
  port we in %we
  port waddr in %waddr
  port raddr in %raddr
  port wdata in %wdata
  port rdata out %rdata
  port rom_out out %rom_out
  attr ram_style = "block"
  memory @mem 16 x u8
  memory @rom 4 x u8
    init 8'd222 8'd173 8'd190 8'd239
  cell mem$rd memrd @mem clocked (addr=%raddr, clk=%clk, en=1'd1) -> (data=%rdata)
  cell mem$wr memwr @mem clocked (addr=%waddr, data=%wdata, en=%we, clk=%clk) -> ()
  cell rom$rd memrd @rom (addr=%raddr[1:0]) -> (data=%rom_out)
end
