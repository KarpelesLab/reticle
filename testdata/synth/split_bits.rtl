top split_bits

// Each process registers its own bits of `r`, as a Verilog `generate`
// loop of `always` blocks does (`always @(posedge clk) r[i] <= ...`).
// Process lowering used to refuse the second process (S0016); now each
// gets a part net of just its bits and assigns put them back. Bits 4 and
// 5 come from one process through two separate slices, so its part is
// two bits wide and one run long. The initial value lands on the parts.
module split_bits
  net %clk u1 wire
  net %rst u1 wire
  net %a u6 wire
  net %r u6 reg
  net %y u6 wire
  port clk in %clk
  port rst in %rst
  port a in %a
  port y out %y
  process init initial
    %r = 6'd37
  end
  process p0 seq posedge %clk
    %r[0:0] <= xor(%a[0:0], %r[5:5])
  end
  process p1 seq posedge %clk
    if %rst
      %r[3:1] <= 3'd5
    else
      %r[3:1] <= add(%r[3:1], %a[3:1])
    end
  end
  process p2 seq posedge %clk
    %r[4:4] <= %r[0:0]
    %r[5:5] <= not(%a[5:5])
  end
  assign %y = %r
end
