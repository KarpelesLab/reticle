top mem_part_write

module mem_part_write
  net %clk u1 wire
  net %we u4 wire
  net %nib u1 wire
  net %at u3 wire
  net %waddr u4 wire
  net %raddr u4 wire
  net %wdata u32 wire
  net %rdata u32 wire
  net %mem$wr_5$shl u32 wire
  net %mem$wr_5$shl_2 u32 wire
  net %mem$wr_5$and u32 wire
  port clk in %clk
  port we in %we
  port nib in %nib
  port at in %at
  port waddr in %waddr
  port raddr in %raddr
  port wdata in %wdata
  port rdata out %rdata
  memory @mem 16 x u32
  cell mem$rd memrd @mem clocked (addr=%raddr, clk=%clk, en=1'd1) -> (data=%rdata)
  cell mem$wr memwr @mem clocked (addr=%waddr, data=%wdata, en={{8{%we[3:3]}}, {8{%we[2:2]}}, {8{%we[1:1]}}, {8{%we[0:0]}}}, clk=%clk) -> ()
  cell mem$wr_5$shl shl (a=resize(%wdata[3:0], u32), b={%at, 2'd0}) -> (y=%mem$wr_5$shl)
  cell mem$wr_5$shl_2 shl (a=32'd15, b={%at, 2'd0}) -> (y=%mem$wr_5$shl_2)
  cell mem$wr_5$and and (a=%mem$wr_5$shl_2, b={32{%nib}}) -> (y=%mem$wr_5$and)
  cell mem$wr_5 memwr @mem clocked (addr=%raddr, data=%mem$wr_5$shl, en=%mem$wr_5$and, clk=%clk) -> ()
end
