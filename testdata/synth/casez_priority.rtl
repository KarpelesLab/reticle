top casez_priority

module casez_priority
  net %req u4 wire
  net %grant u2 reg
  net %valid u1 reg
  port req in %req
  port grant out %grant
  port valid out %valid
  process arbiter comb
    %valid = 1'd1
    casez %req
      when 4'bzzz1
        %grant = 2'd0
      end
      when 4'bzz1z
        %grant = 2'd1
      end
      when 4'bz1zz
        %grant = 2'd2
      end
      when 4'b1zzz
        %grant = 2'd3
      end
      default
        %grant = 2'd0
        %valid = 1'd0
      end
    end
  end
end
