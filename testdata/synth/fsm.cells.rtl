top fsm

module fsm
  net %clk u1 wire
  net %rst u1 wire
  net %go u1 wire
  net %done u1 wire
  net %busy u1 wire
  attr fsm_encoded = "one-hot"
  net %state$fsm u3 wire
  net %state$pmux$fsm u3 wire
  net %state$ff$and u1 wire
  net %state$ff$or u1 wire
  net %state$ff$and_2 u1 wire
  net %state$ff$or_2 u1 wire
  net %state$ff$or_3 u1 wire
  net %state$ff$not u1 wire
  net %state$ff$or_4 u1 wire
  net %state$ff$or_5 u1 wire
  port clk in %clk
  port rst in %rst
  port go in %go
  port done in %done
  port busy out %busy
  cell busy$not not (a=%state$fsm[0:0]) -> (y=%busy)
  cell state$ff$and and (a=%state$fsm[0:0], b=%go) -> (y=%state$ff$and)
  cell state$ff$or or (a=%state$ff$and, b=%state$fsm[1:1]) -> (y=%state$ff$or)
  cell state$ff$and_2 and (a=%state$fsm[2:2], b=%done) -> (y=%state$ff$and_2)
  cell state$ff$or_2 or (a=%state$fsm[0:0], b=%state$fsm[1:1]) -> (y=%state$ff$or_2)
  cell state$ff$or_3 or (a=%state$ff$or_2, b=%state$fsm[2:2]) -> (y=%state$ff$or_3)
  cell state$ff$not not (a=%state$ff$or_3) -> (y=%state$ff$not)
  cell state$ff$or_4 or (a=%state$ff$and_2, b=%state$ff$not) -> (y=%state$ff$or_4)
  cell state$ff$or_5 or (a=%state$ff$or, b=%state$ff$or_4) -> (y=%state$ff$or_5)
  cell state$ff dff pos en srst pos 3'd1 (clk=%clk, d=%state$pmux$fsm, en=%state$ff$or_5, rst=%rst) -> (q=%state$fsm)
  cell state$pmux$fsm pmux (a=3'd1, b=9'd98, s=%state$fsm) -> (y=%state$pmux$fsm)
end
