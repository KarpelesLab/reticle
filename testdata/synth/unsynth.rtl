top unsynth

module unsynth
  net %clk u1 wire
  net %a u1 wire
  net %y u1 reg
  net %count u8 reg
  port clk in %clk
  port a in %a
  port y out %y
  process initial
    sys $display("hello")
    %count = 8'd0
  end
  process ticker free
    wait for 8'd10
    %count = add(%count, 8'd1)
  end
  process seq posedge %clk
    %y <= %a
    assert error %a report "a must be set"
  end
end
