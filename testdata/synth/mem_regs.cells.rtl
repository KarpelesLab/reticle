top mem_regs

module mem_regs
  net %clk u1 wire
  net %a u8 wire
  net %b u8 wire
  net %sel u1 wire
  net %en u1 wire
  net %y u8 wire
  net %z u8 wire
  net %r u8 wire
  attr init = 8'd1
  net %c$0 u8 wire
  attr init = 8'd2
  net %c$1 u8 wire
  attr init = 8'd3
  net %c$2 u8 wire
  attr init = 8'd4
  net %c$3 u8 wire
  net %c$2$ff$add u8 wire
  net %c$3$ff$mux u8 wire
  port clk in %clk
  port a in %a
  port b in %b
  port sel in %sel
  port en in %en
  port y out %y
  port z out %z
  port r out %r
  assign %y = %c$3
  assign %z = 8'd6
  cell c$0$ff dff pos (clk=%clk, d=%a) -> (q=%c$0)
  cell c$1$ff dff pos (clk=%clk, d=%c$0) -> (q=%c$1)
  cell c$2$ff$add add (a=%c$1, b=8'd1) -> (y=%c$2$ff$add)
  cell c$2$ff dff pos (clk=%clk, d=%c$2$ff$add) -> (q=%c$2)
  cell c$3$ff$mux mux (a=%c$2, b=%b, s=%sel) -> (y=%c$3$ff$mux)
  cell c$3$ff dff pos (clk=%clk, d=%c$3$ff$mux) -> (q=%c$3)
  cell c$rd$ff dff pos en (clk=%clk, d=%c$3, en=%en) -> (q=%r)
end
