top fsm

module fsm
  net %clk u1 wire
  net %rst u1 wire
  net %go u1 wire
  net %done u1 wire
  net %busy u1 reg
  attr fsm_encoding = "one-hot"
  net %state u2 reg
  port clk in %clk
  port rst in %rst
  port go in %go
  port done in %done
  port busy out %busy
  process seq posedge %clk
    if %rst
      %state <= 2'd0
    else
      case %state
        when 2'd0
          if %go
            %state <= 2'd1
          end
        end
        when 2'd1
          %state <= 2'd2
        end
        when 2'd2
          if %done
            %state <= 2'd0
          end
        end
        default
          %state <= 2'd0
        end
      end
    end
  end
  process comb
    %busy = ne(%state, 2'd0)
  end
end
