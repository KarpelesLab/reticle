top top

module leaf
  net %a u1 wire
  net %y u1 wire
  port a in %a
  port y out %y
  assign %y = not(%a)
end

module mid
  net %a u1 wire
  net %y u1 wire
  net %n u1 wire
  port a in %a
  port y out %y
  instance u0 of leaf (a=%a, y=%n)
  assign %y = %n
end

module other
  net %a u1 wire
  net %y u1 wire
  port a in %a
  port y out %y
  assign %y = %a
end

module top
  net %a u1 wire
  net %y u1 wire
  net %z u1 wire
  port a in %a
  port y out %y
  port z out %z
  instance u0 of mid (a=%a, y=%y)
  instance u1 of other (a=%a, y=%z)
end
