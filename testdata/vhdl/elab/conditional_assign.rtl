top conditional_assign

module conditional_assign
  timescale 1 fs / 1 fs
  net %a u1 wire
  net %b u1 wire
  net %c u1 wire
  net %sel u2 wire
  net %y u1 wire
  port a in %a
  port b in %b
  port c in %c
  port sel in %sel
  port y out %y
  assign %y = mux(eq(%sel, 2'd0), %a, mux(eq(%sel, 2'd1), %b, %c))
end
