top counter

module counter
  timescale 1 fs / 1 fs
  net %clk u1 wire
  net %rst u1 wire
  net %en u1 wire
  net %q u8 wire
  net %full u1 wire
  net %cnt u8 reg
  port clk in %clk
  port rst in %rst
  port en in %en
  port q out %q
  port full out %full
  assign %q = %cnt
  assign %full = mux(eq(%cnt, 8'd255), 1'd1, 1'd0)
  process seq posedge %clk async posedge %rst
    if eq(%rst, 1'd1)
      %cnt <= 8'd0
    else
      if eq(%en, 1'd1)
        %cnt <= add(%cnt, 8'd1)
      end
    end
  end
end
