top tb

module tb
  timescale 1 fs / 1 fs
  net %clk u1 reg
  net %phase s8 reg
  net %"clocking.i" s32 var
  process initial
    %clk = 1'd0
  end
  process initial
    %phase = 8'sd0
  end
  process clocking free
    forever
      for %"clocking.i" = 32'sd0; le(%"clocking.i", 32'sd3); %"clocking.i" = add(%"clocking.i", 32'sd1)
        wait for 64'sd10000000
        %clk <= 1'd1
        wait for 64'sd10000000
        %clk <= 1'd0
      end
      wait until 1'd0
    end
  end
  process stimulus free
    forever
      assert note 1'd0 report "start"
      assert error 1'd1 report "the period is wrong"
      assert error 1'd1 report "sin(0) is wrong"
      assert error 1'd1 report "sin(pi/4) is wrong"
      assert error 1'd1 report "sin(pi/2) is wrong"
      assert error 1'd1 report "sqrt(2) is wrong"
      assert error 1'd1 report "log2 is wrong"
      %phase <= 8'sd90
      wait for 64'sd20000000
      assert error eq(resize(%phase, s32), 32'sd90) report "the phase step is wrong"
      assert note 1'd0 report "done"
      wait until 1'd0
    end
  end
end
