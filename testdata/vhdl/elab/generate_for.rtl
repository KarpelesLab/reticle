top generate_for

module generate_for
  timescale 1 fs / 1 fs
  param N = 4
  net %d u4 wire
  net %q u4 wire
  net %t u4 wire
  net %"bits(0).inv" u1 wire
  net %"bits(1).inv" u1 wire
  net %"bits(2).inv" u1 wire
  net %"bits(3).inv" u1 wire
  port d in %d
  port q out %q
  assign %"bits(0).inv" = not(%d[0:0])
  assign %t[0:0] = %"bits(0).inv"
  assign %"bits(1).inv" = not(%d[1:1])
  assign %t[1:1] = %"bits(1).inv"
  assign %"bits(2).inv" = not(%d[2:2])
  assign %t[2:2] = %"bits(2).inv"
  assign %"bits(3).inv" = not(%d[3:3])
  assign %t[3:3] = %"bits(3).inv"
  assign %q = %t
end
