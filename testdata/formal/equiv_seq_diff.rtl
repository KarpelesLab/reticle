top counter_mux

// Sequential equivalence with a deliberately different pair: the second
// counter steps by two once it reaches 8, so the outputs diverge after
// nine enabled cycles.
attr formal_mode = "equiv"
attr formal_other = "counter_skip"
module counter_mux
  net %clk u1 wire
  net %rst u1 wire
  net %en u1 wire
  net %q u4 wire
  net %inc u4 wire
  net %d u4 wire
  port clk in %clk
  port rst in %rst
  port en in %en
  port q out %q
  assign %inc = add(%q, 4'd1)
  assign %d = mux(%en, %inc, %q)
  cell ff dff pos srst pos 4'd0 (clk=%clk, d=%d, rst=%rst) -> (q=%q)
end

module counter_skip
  net %clk u1 wire
  net %rst u1 wire
  net %en u1 wire
  net %q u4 wire
  net %step u4 wire
  net %inc u4 wire
  net %d u4 wire
  port clk in %clk
  port rst in %rst
  port en in %en
  port q out %q
  assign %step = mux(ge(%q, 4'd8), 4'd2, 4'd1)
  assign %inc = add(%q, %step)
  assign %d = mux(%en, %inc, %q)
  cell ff dff pos srst pos 4'd0 (clk=%clk, d=%d, rst=%rst) -> (q=%q)
end
