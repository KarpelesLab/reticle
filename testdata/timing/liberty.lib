/* A tiny hand-written library, just enough to exercise the non-linear
   delay model: two axes (input transition, output capacitance), a
   negative-unate inverter, a positive-unate AND and a flip-flop with a
   clock-to-Q delay and setup / hold constraints. The numbers are made
   up but internally consistent: bigger load and slower input mean more
   delay. */
library(tiny) {
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit (1, pf);
  default_input_pin_cap : 0.004;

  lu_table_template(delay_2x2) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.01, 0.20");
    index_2 ("0.001, 0.050");
  }
  lu_table_template(constraint_2x2) {
    variable_1 : constrained_pin_transition;
    variable_2 : related_pin_transition;
    index_1 ("0.01, 0.20");
    index_2 ("0.01, 0.20");
  }

  cell(INVX1) {
    area : 1.0;
    pin(A) { direction : input; capacitance : 0.004; }
    pin(Y) {
      direction : output;
      function : "!A";
      timing() {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise(delay_2x2)  { values("0.020, 0.120", "0.040, 0.140"); }
        cell_fall(delay_2x2)  { values("0.015, 0.100", "0.030, 0.115"); }
        rise_transition(delay_2x2) { values("0.020, 0.150", "0.030, 0.160"); }
        fall_transition(delay_2x2) { values("0.015, 0.120", "0.025, 0.130"); }
      }
    }
  }

  cell(AND2X1) {
    area : 2.0;
    pin(A) { direction : input; capacitance : 0.005; }
    pin(B) { direction : input; capacitance : 0.005; }
    pin(Y) {
      direction : output;
      function : "A & B";
      timing() {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise(delay_2x2)  { values("0.050, 0.200", "0.070, 0.220"); }
        cell_fall(delay_2x2)  { values("0.045, 0.180", "0.060, 0.195"); }
        rise_transition(delay_2x2) { values("0.025, 0.170", "0.035, 0.180"); }
        fall_transition(delay_2x2) { values("0.020, 0.140", "0.030, 0.150"); }
      }
      timing() {
        related_pin : "B";
        timing_sense : positive_unate;
        cell_rise(delay_2x2)  { values("0.055, 0.210", "0.075, 0.230"); }
        cell_fall(delay_2x2)  { values("0.048, 0.185", "0.065, 0.200"); }
        rise_transition(delay_2x2) { values("0.025, 0.170", "0.035, 0.180"); }
        fall_transition(delay_2x2) { values("0.020, 0.140", "0.030, 0.150"); }
      }
    }
  }

  cell(DFFX1) {
    area : 5.0;
    ff(IQ, IQN) { clocked_on : "CK"; next_state : "D"; }
    pin(CK) { direction : input; clock : true; capacitance : 0.006; }
    pin(D) {
      direction : input;
      capacitance : 0.004;
      timing() {
        related_pin : "CK";
        timing_type : setup_rising;
        rise_constraint(constraint_2x2) { values("0.080, 0.090", "0.095, 0.110"); }
        fall_constraint(constraint_2x2) { values("0.075, 0.085", "0.090, 0.105"); }
      }
      timing() {
        related_pin : "CK";
        timing_type : hold_rising;
        rise_constraint(constraint_2x2) { values("0.020, 0.025", "0.030, 0.035"); }
        fall_constraint(constraint_2x2) { values("0.018, 0.023", "0.028, 0.033"); }
      }
    }
    pin(Q) {
      direction : output;
      function : "IQ";
      timing() {
        related_pin : "CK";
        timing_type : rising_edge;
        cell_rise(delay_2x2)  { values("0.200, 0.320", "0.215, 0.340"); }
        cell_fall(delay_2x2)  { values("0.180, 0.290", "0.195, 0.310"); }
        rise_transition(delay_2x2) { values("0.030, 0.160", "0.040, 0.175"); }
        fall_transition(delay_2x2) { values("0.025, 0.130", "0.035, 0.145"); }
      }
    }
  }
}
