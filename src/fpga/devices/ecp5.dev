  bel TRELLIS_FF ff mode negedge,async_set port clk=CLK d=DI q=Q en=CE rst=LSR param GSR="DISABLED" REGMODE="FF" CEMUX="1" CLKMUX="INV" LSRMUX="LSR" SRMODE="ASYNC" REGSET="SET"
  bel TRELLIS_FF ff mode negedge,async_set,active_low port clk=CLK d=DI q=Q en=CE rst=LSR param GSR="DISABLED" REGMODE="FF" CEMUX="1" CLKMUX="INV" LSRMUX="INV" SRMODE="ASYNC" REGSET="SET"
  bel TRELLIS_FF ff mode negedge,enable port clk=CLK d=DI q=Q en=CE rst=LSR param GSR="DISABLED" REGMODE="FF" CEMUX="CE" CLKMUX="INV" LSRMUX="LSR" SRMODE="LSR_OVER_CE" REGSET="RESET"
  bel TRELLIS_FF ff mode negedge,enable,sync_reset port clk=CLK d=DI q=Q en=CE rst=LSR param GSR="DISABLED" REGMODE="FF" CEMUX="CE" CLKMUX="INV" LSRMUX="LSR" SRMODE="LSR_OVER_CE" REGSET="RESET"
  bel TRELLIS_FF ff mode negedge,enable,sync_reset,active_low port clk=CLK d=DI q=Q en=CE rst=LSR param GSR="DISABLED" REGMODE="FF" CEMUX="CE" CLKMUX="INV" LSRMUX="INV" SRMODE="LSR_OVER_CE" REGSET="RESET"
  bel TRELLIS_FF ff mode negedge,enable,async_reset port clk=CLK d=DI q=Q en=CE rst=LSR param GSR="DISABLED" REGMODE="FF" CEMUX="CE" CLKMUX="INV" LSRMUX="LSR" SRMODE="ASYNC" REGSET="RESET"
  bel TRELLIS_FF ff mode negedge,enable,async_reset,active_low port clk=CLK d=DI q=Q en=CE rst=LSR param GSR="DISABLED" REGMODE="FF" CEMUX="CE" CLKMUX="INV" LSRMUX="INV" SRMODE="ASYNC" REGSET="RESET"
  bel TRELLIS_FF ff mode negedge,enable,sync_set port clk=CLK d=DI q=Q en=CE rst=LSR param GSR="DISABLED" REGMODE="FF" CEMUX="CE" CLKMUX="INV" LSRMUX="LSR" SRMODE="LSR_OVER_CE" REGSET="SET"
  bel TRELLIS_FF ff mode negedge,enable,sync_set,active_low port clk=CLK d=DI q=Q en=CE rst=LSR param GSR="DISABLED" REGMODE="FF" CEMUX="CE" CLKMUX="INV" LSRMUX="INV" SRMODE="LSR_OVER_CE" REGSET="SET"
  bel TRELLIS_FF ff mode negedge,enable,async_set port clk=CLK d=DI q=Q en=CE rst=LSR param GSR="DISABLED" REGMODE="FF" CEMUX="CE" CLKMUX="INV" LSRMUX="LSR" SRMODE="ASYNC" REGSET="SET"
  bel TRELLIS_FF ff mode negedge,enable,async_set,active_low port clk=CLK d=DI q=Q en=CE rst=LSR param GSR="DISABLED" REGMODE="FF" CEMUX="CE" CLKMUX="INV" LSRMUX="INV" SRMODE="ASYNC" REGSET="SET"
  bel TRELLIS_IO io port pad=B din=O dout=I oe=T param_in DIR="INPUT" param_out DIR="OUTPUT" param_inout DIR="BIDIR" param_pullup PULLMODE="UP"
  bel DCCA gb count 16 port i=CLKI o=CLKO en=CE
  bel TRELLIS_DPR16X4 lutram port wclk=WCK we=WRE waddr=WAD0,WAD1,WAD2,WAD3 din=DI0,DI1,DI2,DI3 raddr=RAD0,RAD1,RAD2,RAD3 dout=DO0,DO1,DO2,DO3 param WCKMUX="WCK" WREMUX="WRE"
  bram DP16KD
    ports 2
    mode 18 1024 param DATA_WIDTH_A=18 DATA_WIDTH_B=18
    mode 9 2048 param DATA_WIDTH_A=9 DATA_WIDTH_B=9
    mode 4 4096 param DATA_WIDTH_A=4 DATA_WIDTH_B=4
    mode 2 8192 param DATA_WIDTH_A=2 DATA_WIDTH_B=2
    mode 1 16384 param DATA_WIDTH_A=1 DATA_WIDTH_B=1
    flags dual_port init
    port rw clk=CLKA en=CEA addr=ADA din=DIA dout=DOA we=WEA rst=RSTA
    port rw clk=CLKB en=CEB addr=ADB din=DIB dout=DOB we=WEB rst=RSTB
  end
  dsp MULT18X18D a 18 b 18 p 36 accumulator stages 3 port a=A b=B c=C p=P clk=CLK0
  io_standard LVCMOS33 vccio 3.3 drive 4,8,12,16,20 slew slow,fast
  io_standard LVCMOS25 vccio 2.5 drive 4,8,12,16 slew slow,fast
  io_standard LVCMOS18 vccio 1.8 drive 4,8,12,16 slew slow,fast
  io_standard LVCMOS15 vccio 1.5 drive 4,8 slew slow,fast
  io_standard LVCMOS12 vccio 1.2 drive 2,4,8 slew slow,fast
  io_standard LVDS vccio 2.5 differential
  bank io vccio 3.3,2.5,1.8,1.5,1.2
  pin G2 clock bank io
  pin B2 io bank io
  pin C1 io bank io
  pin C2 io bank io
  pin D1 io bank io
  pin D2 io bank io
  pin E1 io bank io
  pin E2 io bank io
  pin H3 io bank io
  global_buffers 16
  pll EHXPLLL input 8 400 vco 400 800 outputs 4
end
