# Xilinx Zynq UltraScale+ (XCZU7EV), as far as Reticle has run it on the
# part: the programmable logic of the ZCU104, reached from the processor.
#
# WHAT HAS RUN ON SILICON, on a ZCU104 on 2026-10-09 (docs/fpga-uray.md):
# EMIO GPIO routed through the fabric; lookup tables of every contents;
# an FDRE with its clock, enable and reset driven from Linux, through
# load, capture, hold and synchronous reset; and 32-stage ripple counters
# of FDREs and inverters at 100 and 300 MHz on the processor's clocks.
# On 2026-10-30, an FDRE_1 (the same flip-flop with its half-slice's
# clock inverted), clocked by hand, loading on the falling edge only.
# On 2026-10-15, an AXI slave on M_AXI_HPM0_LPD, read and written by
# Linux at 0x8000_0000, at 100 MHz once every pin from the processor is registered
# before logic reads it (docs/fpga-uray.md).
# Everything else a 7-series file declares — carry chains, wide muxes,
# DSPs, block RAMs, LUT RAMs, the other flip-flop primitives, I/O pads —
# is absent on purpose: a primitive Reticle cannot place correctly is
# better refused than placed.
#
# The ports are the processor's, not the package's. A design talks to
# Linux over EMIO GPIO and is clocked by the processor's PL_CLK0:
#
#   * EMIO_O<k> (k = 0..95) is EMIO GPIO output k, which Linux drives as
#     gpio<594+k>: a design INPUT, through an IBUF.
#   * EMIO_I<k> is EMIO GPIO input k, which Linux reads as gpio<594+k>:
#     a design OUTPUT, through an OBUF.
#   * HPM0_LPD_<signal> is a pin of the processor's AXI master port
#     M_AXI_HPM0_LPD, which Linux reaches at 0x8000_0000: AWADDR0..39,
#     WDATA0..127, AWVALID and so on, in the processor's direction (what
#     it drives is a design input). HPM0_LPD_ACLK is the port's clock, a
#     design output to drive from PL_CLK0.
#   * PL_CLK0 is the processor's first fabric clock, 100 MHz in the PYNQ
#     image: a design input.
#
# Primitive names, ports and the LUT convention are the 7-series ones
# (see xc7.dev for where they were read): UltraScale+ keeps LUT1..LUT6
# with O = INIT[{I5..I0}] and the FD* flip-flops unchanged. No global
# buffer is declared, so a clock is not given a BUFG: the fabric's
# PL_CLK0 is already a global wire, borrowed from Vivado's clock network
# (src/fpga/uray/fabric.rs, PL_CLK0).

device xczu7ev-ffvc1156
  family uray
  package ffvc1156
  speed 2
  idcode 0x04a5a093
  lut_size 6
  ff enable sync_reset shared_reset
  bel LUT6 lut count 230400 port i=I0,I1,I2,I3,I4,I5 o=O param INIT=64'h0000000000000000
  bel LUT5 lut port i=I0,I1,I2,I3,I4 o=O param INIT=32'h00000000
  bel LUT4 lut port i=I0,I1,I2,I3 o=O param INIT=16'h0000
  bel LUT3 lut port i=I0,I1,I2 o=O param INIT=8'h00
  bel LUT2 lut port i=I0,I1 o=O param INIT=4'h0
  bel LUT1 lut port i=I0 o=O param INIT=2'h0
  bel FDRE ff count 460800 mode posedge port clk=C d=D q=Q en=CE rst=R param INIT=1'b0
  bel FDRE ff mode posedge,enable port clk=C d=D q=Q en=CE rst=R param INIT=1'b0
  bel FDRE ff mode posedge,sync_reset port clk=C d=D q=Q en=CE rst=R param INIT=1'b0
  bel FDRE ff mode posedge,enable,sync_reset port clk=C d=D q=Q en=CE rst=R param INIT=1'b0
  bel FDRE_1 ff mode negedge port clk=C d=D q=Q en=CE rst=R param INIT=1'b0
  bel FDRE_1 ff mode negedge,enable port clk=C d=D q=Q en=CE rst=R param INIT=1'b0
  bel FDRE_1 ff mode negedge,sync_reset port clk=C d=D q=Q en=CE rst=R param INIT=1'b0
  bel FDRE_1 ff mode negedge,enable,sync_reset port clk=C d=D q=Q en=CE rst=R param INIT=1'b0
  bel IBUF io for in port pad=I din=O
  bel OBUF io for out port pad=O dout=I
  pin PL_CLK0 clock
  pin EMIO_O0 io
  pin EMIO_O1 io
  pin EMIO_O2 io
  pin EMIO_O3 io
  pin EMIO_O4 io
  pin EMIO_O5 io
  pin EMIO_O6 io
