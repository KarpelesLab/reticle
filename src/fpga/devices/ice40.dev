device ice40-hx8k-ct256
  family ice40
  package ct256
  speed hx
  lut_size 4
  ff enable sync_reset async_reset shared_reset init 0
  bel SB_LUT4 lut count 7680 port i=I0,I1,I2,I3 o=O param LUT_INIT=16'h0000
  bel SB_CARRY carry port ci=CI i0=I0 i1=I1 co=CO
  bel SB_DFF ff count 7680 mode posedge port clk=C d=D q=Q
  bel SB_DFFSR ff mode posedge,sync_reset port clk=C d=D q=Q rst=R
  bel SB_DFFR ff mode posedge,async_reset port clk=C d=D q=Q rst=R
  bel SB_DFFSS ff mode posedge,sync_set port clk=C d=D q=Q rst=S
  bel SB_DFFS ff mode posedge,async_set port clk=C d=D q=Q rst=S
  bel SB_DFFE ff mode posedge,enable port clk=C d=D q=Q en=E
  bel SB_DFFESR ff mode posedge,enable,sync_reset port clk=C d=D q=Q en=E rst=R
  bel SB_DFFER ff mode posedge,enable,async_reset port clk=C d=D q=Q en=E rst=R
  bel SB_DFFESS ff mode posedge,enable,sync_set port clk=C d=D q=Q en=E rst=S
  bel SB_DFFES ff mode posedge,enable,async_set port clk=C d=D q=Q en=E rst=S
  bel SB_DFFN ff mode negedge port clk=C d=D q=Q
  bel SB_DFFNSR ff mode negedge,sync_reset port clk=C d=D q=Q rst=R
  bel SB_DFFNR ff mode negedge,async_reset port clk=C d=D q=Q rst=R
  bel SB_DFFNSS ff mode negedge,sync_set port clk=C d=D q=Q rst=S
  bel SB_DFFNS ff mode negedge,async_set port clk=C d=D q=Q rst=S
  bel SB_DFFNE ff mode negedge,enable port clk=C d=D q=Q en=E
  bel SB_DFFNESR ff mode negedge,enable,sync_reset port clk=C d=D q=Q en=E rst=R
  bel SB_DFFNER ff mode negedge,enable,async_reset port clk=C d=D q=Q en=E rst=R
  bel SB_DFFNESS ff mode negedge,enable,sync_set port clk=C d=D q=Q en=E rst=S
  bel SB_DFFNES ff mode negedge,enable,async_set port clk=C d=D q=Q en=E rst=S
  bel SB_IO io port pad=PACKAGE_PIN din=D_IN_0 dout=D_OUT_0 oe=OUTPUT_ENABLE din1=D_IN_1 dout1=D_OUT_1 iclk=INPUT_CLK oclk=OUTPUT_CLK ce=CLOCK_ENABLE param_in PIN_TYPE=6'b000001 param_out PIN_TYPE=6'b011001 param_inout PIN_TYPE=6'b101001 param_pullup PULLUP=1 param_ddr_in PIN_TYPE=6'b000000 param_ddr_out PIN_TYPE=6'b010000
  bel SB_GB gb count 8 port i=USER_SIGNAL_TO_GLOBAL_BUFFER o=GLOBAL_BUFFER_OUTPUT
  bram SB_RAM40_4K
    ports 2
    mode 16 256 param READ_MODE=0 WRITE_MODE=0 init high 0-15
    mode 8 512 param READ_MODE=1 WRITE_MODE=1 data 0,2,4,6,8,10,12,14 init high 0,2,4,6,8,10,12,14 1,3,5,7,9,11,13,15
    mode 4 1024 param READ_MODE=2 WRITE_MODE=2 data 1,5,9,13 init high 0,4,8,12 1,5,9,13 2,6,10,14 3,7,11,15
    mode 2 2048 param READ_MODE=3 WRITE_MODE=3 data 3,11 init high 0,8 1,9 2,10 3,11 4,12 5,13 6,14 7,15
    flags dual_port init
    init_params INIT_ count 16 digits 1 rows 16 slot 16
    port read clk=RCLK en=RE addr=RADDR dout=RDATA ce=RCLKE
    port write clk=WCLK en=WE addr=WADDR din=WDATA ce=WCLKE
  end
  io_standard LVCMOS33 vccio 3.3
  io_standard LVCMOS25 vccio 2.5
  io_standard LVCMOS18 vccio 1.8
  io_standard SB_LVDS_INPUT vccio 2.5 differential
  bank io vccio 3.3,2.5,1.8
  pins partial
  pin A1 io bank io
  pin A2 io bank io
  pin B3 io bank io
  pin B4 io bank io
  pin B5 io bank io
  pin B10 io bank io
  pin B12 io bank io
