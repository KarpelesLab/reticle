  io_standard LVCMOS25 vccio 2.5
  io_standard LVCMOS18 vccio 1.8
  io_standard SB_LVDS_INPUT vccio 2.5 differential
  bank io vccio 3.3,2.5,1.8
  pin A1 io bank io
