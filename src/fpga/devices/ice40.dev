# Lattice iCE40 LP/HX, as much of it as Reticle can state confidently.
#
# Provenance and confidence, stated per group because it differs:
#
#   * Primitive names and ports (SB_LUT4, SB_CARRY, SB_DFF*, SB_IO, SB_GB,
#     SB_RAM40_4K, SB_PLL40_*) come from the SiliconBlue / Lattice iCE
#     Technology Library, which every published iCE40 design and the
#     Yosys `synth_ice40` pass use verbatim. High confidence.
#   * Logic cell: 4-input LUT plus one carry bit plus one flip-flop; the
#     clock, clock enable and set/reset of the eight logic cells in a tile
#     are shared, which is why `shared_reset` is set. High confidence.
#   * The twenty SB_DFF* lines are the whole family, named by the library's
#     own scheme SB_DFF[N][E][S][S|R]: `N` a falling clock edge, `E` a
#     clock enable, a leading `S` a synchronous rather than asynchronous
#     set or reset, and the final `R`/`S` a reset (to 0, pin `R`) or a set
#     (to 1, pin `S`). Both are active high, which is why no variant is
#     marked `active_low`: an active-low reset has to be inverted in logic
#     first, and flip-flop mapping says so rather than mapping it wrongly.
#     `count` is the number of flip-flops on the die and is recorded once,
#     on the plain variant; they are all the same flip-flop configured
#     differently. High confidence.
#   * SB_RAM40_4K: 4096 bits, configurable 256x16, 512x8, 1024x4 and
#     2048x2, one read port and one write port with independent clocks,
#     contents initialisable through INIT_0..INIT_F. High confidence.
#     The 16-bit mode has a bit-granular MASK input rather than byte
#     enables, so `byte_enable` is deliberately not set. READ_MODE and
#     WRITE_MODE select the width, 0 for 16 bits through 3 for 2 bits.
#   * SB_IO's PIN_TYPE values below (6'b000001 for a plain input,
#     6'b011001 for a plain output, 6'b101001 for a tristatable one) are
#     the ones every published iCE40 design uses. Medium-high confidence.
#   * SB_PLL40_CORE / SB_PLL40_PAD: the ranges (reference 10-133 MHz,
#     phase detector 10-133 MHz, VCO 533-1066 MHz), the fields (DIVR 4
#     bits storing divisor-1, DIVF 7 bits storing divisor-1, DIVQ 1-6
#     storing a power of two) and the FILTER_RANGE bands by phase-detector
#     frequency (below 17, 26, 44, 66, 101 MHz, and above) are the ones
#     Project IceStorm's `icepll` uses for SIMPLE feedback, which is what
#     every published iCE40 design gets its settings from. HIGH confidence
#     for the ranges and fields, MEDIUM for the exact band edges.
#     RESETB is active low and tied high, BYPASS tied low. `count` is the
#     number of PLLs on the die (one on the 1K parts, two on the 8K); the
#     CORE and PAD lines are the same block used two ways. The PAD form
#     takes its reference straight from a package pin rather than from
#     the fabric, so its reference is recorded as `pad`, not `ref`, and
#     Reticle — which generates a clock from the fabric-side net — uses
#     the CORE form.
#   * Resource counts (1280 logic cells and 16 block RAMs on the 1K parts,
#     7680 and 32 on the 8K) are the datasheet figures. High confidence.
#   * The tile grid is the array size used by Project IceStorm's chip
#     database (0..13 x 0..17 for the 1K dice, 0..33 x 0..33 for the 8K).
#     It is consistent with the logic-cell counts above, but Reticle only
#     uses it as a bounding box for placement regions. Medium confidence.
#   * No DSP blocks: multipliers exist only on the UltraPlus parts.
#   * IO: the iCE40 IO buffer has no programmable drive strength or slew
#     rate, so the standards below carry only a bank voltage. The parts
#     have four IO banks (0 top, 1 right, 2 bottom, 3 left), but Reticle
#     cannot state which package pin is in which bank, so a single
#     synthetic bank named `io` holds every recorded pin. Do not read the
#     bank name as silicon truth.
#   * PIN LISTS ARE PARTIAL AND DERIVED FROM BOARD FILES, NOT FROM THE
#     PACKAGE DRAWINGS. The tq144 entries are the pins the Lattice
#     iCEstick uses (12 MHz oscillator, the five LEDs, the FTDI UART and
#     the PMOD header); the ct256 entries are the pins the Lattice iCE40
#     HX8K Breakout Board uses (12 MHz oscillator and the eight LEDs).
#     They are enough to constrain the designs those boards run and are
#     marked `io`/`clock` accordingly; every other pin of both packages is
#     missing, and a constraint naming one is reported as unknown. Add the
#     rest from the datasheet before trusting this file for a new board.

device ice40-lp1k-tq144
  family ice40
  package tq144
  speed lp
  lut_size 4
  ff enable sync_reset async_reset shared_reset init 0
  bel SB_LUT4 lut count 1280 port i=I0,I1,I2,I3 o=O param LUT_INIT=16'h0000
  bel SB_CARRY carry port ci=CI i0=I0 i1=I1 co=CO
  bel SB_DFF ff count 1280 mode posedge port clk=C d=D q=Q
  bel SB_DFFSR ff mode posedge,sync_reset port clk=C d=D q=Q rst=R
  bel SB_DFFR ff mode posedge,async_reset port clk=C d=D q=Q rst=R
  bel SB_DFFSS ff mode posedge,sync_set port clk=C d=D q=Q rst=S
  bel SB_DFFS ff mode posedge,async_set port clk=C d=D q=Q rst=S
  bel SB_DFFE ff mode posedge,enable port clk=C d=D q=Q en=E
  bel SB_DFFESR ff mode posedge,enable,sync_reset port clk=C d=D q=Q en=E rst=R
  bel SB_DFFER ff mode posedge,enable,async_reset port clk=C d=D q=Q en=E rst=R
  bel SB_DFFESS ff mode posedge,enable,sync_set port clk=C d=D q=Q en=E rst=S
  bel SB_DFFES ff mode posedge,enable,async_set port clk=C d=D q=Q en=E rst=S
  bel SB_DFFN ff mode negedge port clk=C d=D q=Q
  bel SB_DFFNSR ff mode negedge,sync_reset port clk=C d=D q=Q rst=R
  bel SB_DFFNR ff mode negedge,async_reset port clk=C d=D q=Q rst=R
  bel SB_DFFNSS ff mode negedge,sync_set port clk=C d=D q=Q rst=S
  bel SB_DFFNS ff mode negedge,async_set port clk=C d=D q=Q rst=S
  bel SB_DFFNE ff mode negedge,enable port clk=C d=D q=Q en=E
  bel SB_DFFNESR ff mode negedge,enable,sync_reset port clk=C d=D q=Q en=E rst=R
  bel SB_DFFNER ff mode negedge,enable,async_reset port clk=C d=D q=Q en=E rst=R
  bel SB_DFFNESS ff mode negedge,enable,sync_set port clk=C d=D q=Q en=E rst=S
  bel SB_DFFNES ff mode negedge,enable,async_set port clk=C d=D q=Q en=E rst=S
  bel SB_IO io port pad=PACKAGE_PIN din=D_IN_0 dout=D_OUT_0 oe=OUTPUT_ENABLE param_in PIN_TYPE=6'b000001 param_out PIN_TYPE=6'b011001 param_inout PIN_TYPE=6'b101001 param_pullup PULLUP=1
  bel SB_GB gb count 8 port i=USER_SIGNAL_TO_GLOBAL_BUFFER o=GLOBAL_BUFFER_OUTPUT
  bram SB_RAM40_4K
    ports 2
    mode 16 256 param READ_MODE=0 WRITE_MODE=0
    mode 8 512 param READ_MODE=1 WRITE_MODE=1
    mode 4 1024 param READ_MODE=2 WRITE_MODE=2
    mode 2 2048 param READ_MODE=3 WRITE_MODE=3
    flags dual_port init
    port read clk=RCLK en=RE addr=RADDR dout=RDATA ce=RCLKE
    port write clk=WCLK en=WE addr=WADDR din=WDATA ce=WCLKE
  end
  io_standard LVCMOS33 vccio 3.3
  io_standard LVCMOS25 vccio 2.5
  io_standard LVCMOS18 vccio 1.8
  io_standard SB_LVDS_INPUT vccio 2.5 differential
  bank io vccio 3.3,2.5,1.8
  pin 8 io bank io
  pin 9 io bank io
  pin 21 clock bank io
  pin 78 io bank io
  pin 79 io bank io
  pin 80 io bank io
  pin 81 io bank io
  pin 87 io bank io
  pin 88 io bank io
  pin 89 io bank io
  pin 90 io bank io
  pin 95 io bank io
  pin 96 io bank io
  pin 97 io bank io
  pin 98 io bank io
  pin 99 io bank io
  global_buffers 8
  clock_region global 0 0 13 17
  pll SB_PLL40_CORE input 10 133 vco 533 1066 outputs 1 count 1 pfd 10 133 feedback vco divide ref DIVR 0 15 offset 1 divide feedback DIVF 0 127 offset 1 divide out DIVQ 1 6 pow2 band FILTER_RANGE 17=1 26=2 44=3 66=4 101=5 134=6 port ref=REFERENCECLK out=PLLOUTCORE lock=LOCK tie RESETB=1 BYPASS=0 param FEEDBACK_PATH="SIMPLE" PLLOUT_SELECT="GENCLK"
  pll SB_PLL40_PAD input 10 133 vco 533 1066 outputs 1 count 1 pfd 10 133 feedback vco divide ref DIVR 0 15 offset 1 divide feedback DIVF 0 127 offset 1 divide out DIVQ 1 6 pow2 band FILTER_RANGE 17=1 26=2 44=3 66=4 101=5 134=6 port pad=PACKAGEPIN out=PLLOUTCORE lock=LOCK tie RESETB=1 BYPASS=0 param FEEDBACK_PATH="SIMPLE" PLLOUT_SELECT="GENCLK"
  grid 14 18
end

