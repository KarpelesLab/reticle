# aac_dec — an AAC-LC decoder (ISO/IEC 14496-3 subpart 4, 13818-7): ADTS
# or raw access units in, 16-bit PCM out, mono or stereo up to 48 kHz,
# every coding tool of the Low Complexity profile.
#
# `aac_dec` is the top. The tables (`aac_huff_rom`, `aac_huff_root`,
# `aac_swb`, `aac_pow43_rom`, `aac_win_rom`, `aac_tw_rom`,
# `aac_gain_mant`, `aac_inv_sqrt`, `aac_tns_refl`) are generated by
# `tools/aac_dec_model.py tables`, from the standard's codebooks and from
# its formulas, and are not to be edited by hand. The same script is the
# bit-accurate model the RTL is checked against: `tests/ip_aac_dec.rs`
# decodes streams ffmpeg's and faac's encoders made and requires the
# model's PCM sample for sample, and ffmpeg's decoder's to within a
# tolerance README.md justifies.
name aac_dec
version 0.1.0
license MIT
description "AAC-LC decoder: ADTS or raw access units to 16-bit PCM, mono or stereo up to 48 kHz, with M/S, intensity, PNS, TNS, pulses and block switching, on DSP slices and block RAM"

top aac_dec
target xc7

source rtl/aac_huff_root.v
source rtl/aac_huff_rom.v
source rtl/aac_swb.v
source rtl/aac_pow43_rom.v
source rtl/aac_win_rom.v
source rtl/aac_tw_rom.v
source rtl/aac_gain_mant.v
source rtl/aac_inv_sqrt.v
source rtl/aac_tns_refl.v
source rtl/aac_ram.v
source rtl/aac_glen.v
source rtl/aac_bits.v
source rtl/aac_huff.v
source rtl/aac_parse.v
source rtl/aac_dequant.v
source rtl/aac_stereo.v
source rtl/aac_tns.v
source rtl/aac_synth.v
source rtl/aac_pcm_out.v
source rtl/aac_dec.v

port clk in
port rst_n in
port cfg_raw in
port cfg_sfi in 4
port cfg_chan in 2
port in_data in 8
port in_valid in
port in_last in
port in_ready out
port out_data out 16
port out_right out
port out_last out
port out_valid out
port out_ready in
port stat_sfi out 4
port stat_stereo out
port frame_ok out
port frame_err out
port err_code out 4
