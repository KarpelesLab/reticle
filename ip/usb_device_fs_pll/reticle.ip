# usb_device_fs_pll: `usb_device_fs` with its 48 MHz asked of the
# device's PLL through a `clock_mhz` attribute on an undriven net, fed
# from `clk_ref`, which the board must describe with a `create_clock`
# (12 MHz gives 48 exactly on both families). A package of its own for
# the reason `dvi_tx_pll` is one: see
# `a_project_top_that_is_also_instantiated_with_an_override_is_lost`.
name usb_device_fs_pll
version 1.0.0
license MIT
description "usb_device_fs with its 48 MHz clock generated by the device's PLL from a 12 MHz board clock"

top usb_device_fs_pll
target ice40
target ecp5

source rtl/usb_device_fs_pll.v

depends usb_device_fs ^1.0.0

param VID bits 16'h1209
param PID bits 16'h0001

port clk_ref in
port rst_n in
port usb_dp_i in
port usb_dn_i in
port usb_dp_o out
port usb_dn_o out
port usb_oe out
port usb_dp_pu out
port address out 7
port configured out
port usb_reset out
