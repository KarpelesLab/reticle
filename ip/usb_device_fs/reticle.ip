# usb_device_fs: a USB 2.0 full-speed device on a 48 MHz clock: the
# line (NRZI, bit stuffing, SYNC, EOP), packets with their CRC5 and
# CRC16 checked, and a control endpoint that enumerates. VID and PID go
# into the device descriptor; 1209:0001 is pid.codes' test pair. The
# package `usb_device_fs_pll` makes the 48 MHz from a 12 MHz board
# clock with the device's PLL.
#
# `usb_dev_core` is the device above the line — `usb_pkt_rx` for the
# packet decoding, `usb_ctrl_ep` for endpoint 0 and `usb_bulk_ep` for the
# endpoint that moves bytes — and is a module of its own because
# `usb_device_ulpi` depends on this package for it: a board whose USB
# lines go through a ULPI transceiver needs the same device and none of
# `usb_fs_rx` or `usb_fs_tx`. All four share `rtl/usb_ctrl_ep.v`, and the
# head of that file says which test's source list is the reason.
name usb_device_fs
version 1.0.0
license MIT
description "USB full-speed device: NRZI and bit stuffing, CRC5 and CRC16 checked, a control endpoint answering GET_DESCRIPTOR, SET_ADDRESS and SET_CONFIGURATION, and a bulk endpoint pair with a byte interface"

top usb_device_fs
target ice40
target ecp5

source rtl/usb_fs_rx.v
source rtl/usb_fs_tx.v
source rtl/usb_ctrl_ep.v
source rtl/usb_device_fs.v

param VID bits 16'h1209
param PID bits 16'h0001
param DEV_CLASS bits 8'hFF
param DEV_SUBCLASS bits 8'h00
param DEV_PROTOCOL bits 8'h00
param CFG_ATTR bits 8'h80
param CFG_POWER bits 8'd50
param IFACE_BYTES int 23 9..64
param DATA_ENDP bits 4'd1
param MAXPKT bits 7'd64
param MAXPKT0 bits 7'd64

port clk48 in
port rst_n in
port usb_dp_i in
port usb_dn_i in
port usb_dp_o out
port usb_dn_o out
port usb_oe out
port usb_dp_pu out
port address out 7
port configured out
port usb_reset out
port out_data out 8
port out_valid out
port out_last out
port out_ready in
port in_data in 8
port in_valid in
port in_ready out
port in_commit in
